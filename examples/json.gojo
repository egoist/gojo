// Reads a JSON document, looks things up in it, changes it and prints it
// again: `gojo run examples/json.gojo [FILE]` (without FILE: a sample).
use std/{json, os}

fn sample() -> str {
    return `{"name": "gojo", "version": 0.1, "tags": ["fast", "safe", null, true],
        "nested": {"a": [1, 2, {"b": "q\"uote"}], "empty": {}, "none": []}}`
}

// The number of values in `v`, counting `v` itself.
fn count(v: json.Value) -> int {
    return match v {
        .Arr(items) => {
            var n = 1
            for x in items {
                n += count(x)
            }
            n
        }
        .Obj(fields) => {
            var n = 1
            for _, x in fields {
                n += count(x)
            }
            n
        }
        _ => 1
    }
}

fn main() ! json.Error {
    let args = os.args()
    let text = if args.len() > 1 {
        os.readText(args[1]) catch e {
            eprintln("cannot read input:", e.message())
            os.exit(1)
        }
    } else {
        sample().toString()
    }
    var doc = try json.parse(text)
    println("values:", count(doc), "keys:", doc.keys())

    // lookups produce nothing when the key or index is missing
    if let name = doc.get("name") {
        println("name:", name.str() ?? "(not a string)")
    }
    if let tags = doc.get("tags") {
        for i in 0..tags.len() {
            let t = tags.at(i).unwrap()
            println("  tag", i, t.encode())
        }
    }
    println("has license:", doc.get("license").isSome())

    // changing the document
    doc.set("version", json.number(0.2))
    var authors = json.array()
    authors.push(json.string("you"))
    doc.set("authors", authors)
    println(doc.pretty())

    // errors say where
    _ = json.parse("[1, 2,, 3]") catch e {
        println("error:", e.message())
        json.null()
    }
}
