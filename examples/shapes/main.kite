use fmt
use ./geom

type Celsius f64
type Fahrenheit f64

fn toF(c Celsius) Fahrenheit {
    return Fahrenheit(f64(c) * 9.0 / 5.0 + 32.0)
}

struct Base {
    id int

    fn describe(self) String {
        return fmt.sprint("entity", self.id)
    }
}

struct Player {
    Base
    name String
}

const MaxPlayers = 4

fn total(shapes []geom.Shape) f64 {
    var t = 0.0
    for s in shapes {
        t += s.area()
    }
    return t
}

fn main() {
    let a = geom.Vec2{x: 3.0, y: 4.0}
    println(a.length(), a.add(a))
    var shapes = Vec[geom.Shape]{}
    shapes.push(geom.Rect{min: geom.Vec2{x: 0.0, y: 0.0}, max: geom.Vec2{x: 2.0, y: 3.0}})
    shapes.push(geom.Circle{center: a, r: 1.0})
    for s in shapes {
        println(s.name(), s.area())
    }
    println("total", total(shapes))
    println(toF(Celsius(100.0)))
    let p = Player{Base: Base{id: 7}, name: "kim"}
    println(p.id, p.describe(), p.name, MaxPlayers)
}

test "vector length" {
    let v = geom.Vec2{x: 6.0, y: 8.0}
    assertEq(v.length(), 10.0)
}

test "celsius" {
    assert(f64(toF(Celsius(0.0))) == 32.0)
}
