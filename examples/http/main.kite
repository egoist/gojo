// `kite run examples/http`: starts the server and checks it with a few clients.
// `kite run examples/http serve`: serves on :8080 until interrupted.
use std/{fmt, http, io, net, os, task, time}

struct App {
    fn serve(self, req http.Request) http.Response {
        return match req.path.asStr() {
            "/" => http.text(200, "hello\n")
            "/echo" => http.text(200, req.text())
            "/hi" => http.text(200, "hi " + (req.param("name") ?? "stranger".toString()) + "\n")
            "/slow" => {
                // cancelled at the deadline, or when the client hangs up
                time.sleep(10 * time.second)
                http.text(200, "finally\n")
            }
            _ => http.text(404, "not found\n")
        }
    }
}

fn status(port int, path str) String ! io.Error {
    let r = try http.get(fmt.format("http://127.0.0.1:{}{}", port, path))
    return fmt.format("{} {}", r.status, http.statusText(r.status))
}

fn hangUp(port int, path str) ! io.Error {
    let c = try net.dial(fmt.format("127.0.0.1:{}", port))
    try c.writeText("GET " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n")
    // dropping `c` closes the connection without reading the answer
}

fn main() ! io.Error {
    let stats = Mutex(http.Stats{})
    let app = App{}
    let args = os.args()
    if args.len() > 1 && args[1] == "serve" {
        let ln = try net.listen(":8080")
        println("listening on :8080")
        http.serve(ln, app, http.Options{deadline: time.second})
        return
    }

    let ln = try net.listen("127.0.0.1:0")
    let port = ln.port()
    let start = time.now()
    let stop = chan[bool]()
    let opts = http.Options{deadline: 50 * time.millisecond}
    _ = task.group((g) => {
        // the server, in a group of its own so that it can be stopped alone
        g.go(() => {
            _ = task.group((sg) => {
                sg.go(() => { http.serveCounting(ln, app, opts, stats) })
                _ = <-stop
                sg.cancel()
            })
        })
        let fast = task.group((cg) => {
            for _ in 0..20 {
                cg.go(() => {
                    let line = try status(port, "/")
                    if line != "200 OK" { println("unexpected", line) }
                })
            }
        })
        println("20 requests to /:", fast.isOk())
        println("/missing:", status(port, "/missing") catch _e { "?".toString() })
        let hi = http.get(fmt.format("http://127.0.0.1:{}/hi?name=k%C3%AFte+lang", port)) catch _e { http.text(0, "?") }
        print("/hi:", hi.text())
        let echo = http.post(fmt.format("http://127.0.0.1:{}/echo", port), "text/plain", "posted body".bytes()) catch _e { http.text(0, "?") }
        println("/echo:", echo.status, echo.text(), echo.header("content-type") ?? "")
        println("/slow:", status(port, "/slow") catch _e { "?".toString() })
        _ = hangUp(port, "/slow")
        // wait until the server has noticed the hang-up
        for _ in 0..200 {
            var seen = false
            with s = stats.lock() { seen = s.hungUp > 0 }
            if seen { break }
            time.sleep(time.millisecond)
        }
        // a request still in flight when the server stops
        _ = task.group((cg) => {
            cg.go(() => {
                let line = status(port, "/slow") catch _e { "connection closed".toString() }
                println("in flight at shutdown:", line)
            })
            time.sleep(10 * time.millisecond)
            stop <- true
        })
    })
    with s = stats.lock() {
        println("served", s.served, "timed out", s.timedOut, "hung up", s.hungUp, "stopped", s.stopped)
    }
    println("took less than 1s:", time.since(start) < time.second)
}
