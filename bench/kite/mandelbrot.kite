fn main() {
    let n = 2000
    let fn_ = f64(n)
    var inside = 0
    for y in 0..n {
        let ci = 2.0 * f64(y) / fn_ - 1.0
        for x in 0..n {
            let cr = 2.0 * f64(x) / fn_ - 1.5
            var zr = 0.0
            var zi = 0.0
            var i = 0
            var escaped = false
            for i < 50 {
                let tr = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = tr
                if zr * zr + zi * zi > 4.0 {
                    escaped = true
                    break
                }
                i += 1
            }
            if !escaped {
                inside += 1
            }
        }
    }
    println(inside)
}
