struct Node {
    left: ?Box[Node]
    right: ?Box[Node]
}

fn make(depth: int) -> Node {
    if depth == 0 {
        return Node{left: none, right: none}
    }
    return Node{left: Box(make(depth - 1)), right: Box(make(depth - 1))}
}

fn check(n: Node) -> int {
    var c = 1
    if let l = n.left {
        c += check(l)
    }
    if let r = n.right {
        c += check(r)
    }
    return c
}

fn main() {
    let n = 18
    let minDepth = 4
    let maxDepth = max(minDepth + 2, n)
    let stretch = maxDepth + 1
    println("stretch tree of depth", stretch, "check:", check(make(stretch)))
    let long = make(maxDepth)
    var d = minDepth
    while d <= maxDepth{
        let iterations = 1 << (maxDepth - d + minDepth)
        var sum = 0
        for _ in 0..iterations {
            sum += check(make(d))
        }
        println(iterations, "trees of depth", d, "check:", sum)
        d += 2
    }
    println("long lived tree of depth", maxDepth, "check:", check(long))
}
