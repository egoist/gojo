// 100k goroutines, each parked on a channel until all exist, then a relay
// through all of them.
fn main() {
    let n = 100000
    let start = chan[bool]()
    var prev = chan[int]()
    let first = prev.tx.clone()
    for _ in 0..n {
        let next = chan[int]()
        let input = prev.rx.clone()
        let output = next.tx.clone()
        let s = start.rx.clone()
        go () => {
            _ = <-s
            let v = (<-input).unwrap()
            output <- v + 1
        }
        prev = next
    }
    drop(start.tx)
    first <- 0
    println((<-prev.rx).unwrap())
}
