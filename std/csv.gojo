// CSV (RFC 4180): rows of fields separated by commas (or another separator).
// A field may be quoted with `"`, and then hold separators, line breaks and
// `""` for a quote. Lines end with `\n` or `\r\n`; empty lines are skipped.
//
//   let rows = try csv.parse("name,age\n\"Lee, Ann\",30\n")
//   // [["name", "age"], ["Lee, Ann", "30"]]
//   csv.format(rows)                     // the same text back
//
//   var r = csv.reader(try os.open("big.csv"))
//   while let row = try r.readRow() { ... }  // one row at a time
use std/{io, bufio}

// Text that isn't valid CSV, or a read that failed.
pub struct Error {
    pub msg: String
    // where, from 1
    pub line: int
    pub column: int

    pub fn message(self) -> String {
        return "csv: ${self.msg} at line ${self.line}, column ${self.column}"
    }
}

fn sepByte(sep: rune) -> byte {
    if sep < 0 || sep >= 128 || sep == '"' || sep == '\n' || sep == '\r' {
        panic("csv: the separator must be an ASCII character other than a quote or a line break")
    }
    return byte(sep)
}

// Reads records from text, tracking the line for errors.
struct Parser {
    sep: byte
    pos: int = 0
    line: int = 1
    // the offset where the current line starts, for columns
    lineStart: int = 0

    fn fail(self, msg: str, at: int) -> Error {
        return Error{msg: msg.toString(), line: self.line, column: at - self.lineStart + 1}
    }

    fn newline(inout self, next: int) {
        self.pos = next
        self.line += 1
        self.lineStart = next
    }

    // The next record of `text` from `pos`, or none at the end.
    fn record(inout self, text: str) -> ?Vec[String] ! Error {
        let b = text.bytes()
        let n = b.len()
        // empty lines
        loop {
            if self.pos < n && b[self.pos] == 10 {
                self.newline(self.pos + 1)
            } else if self.pos + 1 < n && b[self.pos] == 13 && b[self.pos + 1] == 10 {
                self.newline(self.pos + 2)
            } else {
                break
            }
        }
        if self.pos >= n {
            return none
        }
        var fields = Vec[String]{}
        loop {
            if self.pos >= n {
                // after a final separator
                fields.push("")
                return fields
            }
            if b[self.pos] == 34 {
                let open = self.fail("a quoted field never ends", self.pos)
                self.pos += 1
                var f: String = ""
                loop {
                    let q = text[self.pos..].find("\"") ?? return err(open)
                    let seg = text[self.pos..self.pos + q]
                    let lines = seg.count("\n")
                    if lines > 0 {
                        self.line += lines
                        self.lineStart = self.pos + seg.rfind("\n").unwrap() + 1
                    }
                    f.push(seg)
                    self.pos += q + 1
                    if self.pos < n && b[self.pos] == 34 {
                        f.push("\"")
                        self.pos += 1
                        continue
                    }
                    break
                }
                fields.push(f)
                if self.pos >= n {
                    return fields
                }
                let c = b[self.pos]
                if c == self.sep {
                    self.pos += 1
                    continue
                }
                if c == 10 {
                    self.newline(self.pos + 1)
                    return fields
                }
                if c == 13 && self.pos + 1 < n && b[self.pos + 1] == 10 {
                    self.newline(self.pos + 2)
                    return fields
                }
                return err(self.fail("unexpected character after a quoted field", self.pos))
            }
            let st = self.pos
            while self.pos < n{
                let c = b[self.pos]
                if c == self.sep || c == 10 || (c == 13 && self.pos + 1 < n && b[self.pos + 1] == 10) {
                    break
                }
                if c == 34 {
                    return err(self.fail("a quote in an unquoted field (quote the whole field and write it as \"\")", self.pos))
                }
                self.pos += 1
            }
            fields.push(text[st..self.pos].toString())
            if self.pos >= n {
                return fields
            }
            let c = b[self.pos]
            if c == self.sep {
                self.pos += 1
                continue
            }
            self.newline(self.pos + if c == 13 { 2 } else { 1 })
            return fields
        }
    }
}

// The rows of comma-separated `text`. Rows may have different numbers of
// fields.
pub fn parse(text: str) -> Vec[Vec[String]] ! Error {
    return parseSep(text, ',')
}

// The rows of `text` with `sep` between fields (`'\t'`, `';'`...), which must
// be ASCII.
pub fn parseSep(text: str, sep: rune) -> Vec[Vec[String]] ! Error {
    var p = Parser{sep: sepByte(sep)}
    var rows = Vec[Vec[String]]{}
    loop {
        let row = try p.record(text) ?? break
        rows.push(row)
    }
    return rows
}

// Reads rows one at a time from a stream, so a large file never has to be in
// memory at once.
pub struct Reader[R: io.Reader] {
    src: bufio.Reader[R]
    p: Parser

    // The next row, or none at the end.
    pub fn readRow(inout self) -> ?Vec[String] ! Error {
        loop {
            // whole lines, until the quotes balance: a quoted field can hold
            // line breaks
            var chunk = Vec[byte]{}
            var quotes = 0
            loop {
                let line = self.src.readUntil(10) catch e {
                    return err(Error{msg: e.message(), line: self.p.line, column: 1})
                }
                let got = line ?? break
                quotes += got.count(c => c == 34)
                chunk.extend(got)
                if quotes % 2 == 0 {
                    break
                }
            }
            if chunk.isEmpty() {
                return none
            }
            let text = String(chunk)
            self.p.pos = 0
            self.p.lineStart = 0
            if let row = try self.p.record(text) {
                return row
            }
            // an empty line: on to the next
        }
    }
}

// A reader of comma-separated rows from `src`.
pub fn reader[R: io.Reader](src: sink R) -> Reader[R] {
    return Reader[R]{src: bufio.reader(src), p: Parser{sep: 44}}
}

// A reader of rows with `sep` between fields.
pub fn readerSep[R: io.Reader](src: sink R, sep: rune) -> Reader[R] {
    return Reader[R]{src: bufio.reader(src), p: Parser{sep: sepByte(sep)}}
}

fn pushField(out: inout String, f: str, sep: byte) {
    var quote = f.len() > 0 && (f.startsWith(" ") || f.endsWith(" "))
    if !quote {
        for c in f.bytes() {
            if c == sep || c == 34 || c == 10 || c == 13 {
                quote = true
                break
            }
        }
    }
    if !quote {
        out.push(f)
        return
    }
    out.push("\"")
    out.push(f.replace("\"", "\"\""))
    out.push("\"")
}

fn pushRow(out: inout String, fields: []String, sep: byte) {
    for i, f in fields {
        if i > 0 {
            out.pushRune(rune(sep))
        }
        pushField(&out, f, sep)
    }
}

// One row as CSV, without a line break. Fields are quoted only when they
// need it: with a separator, quote or line break, or spaces at either end.
pub fn formatRow(fields: []String) -> String {
    var out: String = ""
    pushRow(&out, fields, 44)
    return out
}

// The rows as CSV, each ending with `\n`.
pub fn format(rows: []Vec[String]) -> String {
    return formatSep(rows, ',')
}

// The rows with `sep` between fields.
pub fn formatSep(rows: []Vec[String], sep: rune) -> String {
    let s = sepByte(sep)
    var out: String = ""
    for row in rows {
        pushRow(&out, row, s)
        out.push("\n")
    }
    return out
}
