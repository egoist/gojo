// HTTP/1.1: a server built on tasks, scopes and cancellation, and a
// small client, over plain TCP or TLS (`serveTls`, `https://` URLs).
//
//   struct Hello {
//       fn serve(self, req: http.Request) -> http.Response {
//           return http.text(200, "hello " + (req.param("name") ?? "world"))
//       }
//   }
//   fn main() ! io.Error {
//       let ln = try net.listen(":8080")
//       http.serve(ln, Hello{}, http.Options{})
//   }
//
// Every connection is a task in the server's scope, so cancelling the task
// that runs `serve` cancels the requests in flight (their clients get 503).
// A connection carries requests one after another while the client keeps it
// open (`Options.keepAlive`, `Options.idleTimeout`); the client side reuses
// connections too. `Request.route` matches paths like "/todos/:id". Every request runs under a
// deadline (`Options.deadline`): a handler still running then is cancelled and
// the client gets 504. A client that hangs up cancels its request too: the
// handler's blocking calls return early.
use std/{fmt, io, net, task, time, tls}

// A connection, plain or encrypted.
enum Stream {
    Plain(net.Conn)
    Secure(tls.Conn)

    fn read(self, buf: inout Vec[byte], max: int) -> int ! io.Error {
        return match self {
            Plain(c) => c.read(&buf, max)
            Secure(c) => c.read(&buf, max)
        }
    }

    fn write(self, data: []byte) ! io.Error {
        return match self {
            Plain(c) => c.write(data)
            Secure(c) => c.write(data)
        }
    }

    fn writeText(self, s: str) ! io.Error {
        return self.write(s.bytes())
    }
}

// A header line. Names are matched without regard to case.
pub struct Header {
    pub name: String
    pub value: String
}

// The value of header `name` (any case) in `hs`.
pub fn findHeader(hs: []Header, name: str) -> ?String {
    let want = name.toLower()
    for h in hs {
        if h.name.toLower() == want {
            return some(h.value.clone())
        }
    }
    return none
}

// A request, as a handler gets it: the whole body has been read (up to
// `Options.maxBody`).
pub struct Request {
    pub method: String
    // the path, without the query
    pub path: String
    // what follows `?` in the target, still percent-encoded
    pub rawQuery: String = ""
    pub headers: Vec[Header] = []
    pub body: Vec[byte] = []

    // The value of header `name` (any case).
    pub fn header(self, name: str) -> ?String {
        return findHeader(self.headers, name)
    }

    // A query parameter, decoded: "/search?q=a+b" has param("q") == "a b".
    pub fn param(self, name: str) -> ?String {
        for part in self.rawQuery.split("&") {
            let kv = part.split("=")
            if kv.len() > 0 && (decode(kv[0]) ?? "") == name {
                if kv.len() == 1 {
                    return some("")
                }
                return decode(part[kv[0].len() + 1..])
            }
        }
        return none
    }

    // The path's parts: "/todos/7" -> ["todos", "7"].
    pub fn segments(self) -> Vec[String] {
        var out = Vec[String]{}
        for s in self.path.split("/") {
            if s.len() > 0 {
                out.push(decode(s) ?? s.clone())
            }
        }
        return out
    }

    // The body, as a string.
    pub fn text(self) -> String {
        return String(self.body.clone())
    }

    // Matches the request against a method ("" for any; "GET" also matches
    // HEAD) and a path pattern of literal segments, `:name` for any one
    // segment and a final `*name` for the rest of the path (maybe empty).
    // Some(params) with the segments captured, decoded; none if it doesn't
    // match. Empty segments are ignored, so "/todos/" matches "/todos".
    //
    //   fn serve(self, req: http.Request) -> http.Response {
    //       if let p = req.route("GET", "/todos/:id") {
    //           return self.show(p.int("id") ?? 0)
    //       }
    //       if let p = req.route("GET", "/files/*path") {
    //           return self.file(p.get("path"))
    //       }
    //       return http.text(404, "not found\n")
    //   }
    pub fn route(self, method: str, pattern: str) -> ?Params {
        if method.len() > 0 && method != self.method && !(method == "GET" && self.method == "HEAD") {
            return none
        }
        let path = self.path.asStr()
        var params = Params{}
        var pi = 0
        var xi = 0
        loop {
            let (ps, pe) = nextSegment(pattern, pi)
            let (xs, xe) = nextSegment(path, xi)
            if ps < 0 {
                return if xs < 0 { some(params) } else { none }
            }
            let seg = pattern[ps..pe]
            if seg.startsWith("*") {
                params.add(seg[1..], if xs < 0 { "" } else { path[xs..] })
                return some(params)
            }
            if xs < 0 {
                return none
            }
            let got = path[xs..xe]
            if seg.startsWith(":") {
                params.add(seg[1..], got)
            } else if seg != got && (!got.contains("%") || decodePath(got) != seg) {
                return none
            }
            pi = pe
            xi = xe
        }
    }
}

// Where the next non-empty `/`-separated segment of `s` at or after `from`
// starts and ends; (-1, -1) when there is none.
fn nextSegment(s: str, from: int) -> (int, int) {
    let b = s.bytes()
    var i = from
    while i < b.len() && b[i] == 47 {
        i += 1
    }
    if i == b.len() {
        return (-1, -1)
    }
    var j = i
    while j < b.len() && b[j] != 47 {
        j += 1
    }
    return (i, j)
}

// The segments `Request.route` captured, by name.
pub struct Params {
    names: Vec[String] = []
    values: Vec[String] = []

    fn add(inout self, name: str, raw: str) {
        self.names.push(name.toString())
        self.values.push(if raw.contains("%") { decodePath(raw) } else { raw.toString() })
    }

    // The value captured as `name`; "" if the pattern has no such name.
    pub fn get(self, name: str) -> str {
        for i in 0..self.names.len() {
            if self.names[i] == name {
                return self.values[i].asStr()
            }
        }
        return ""
    }

    // The value captured as `name`, as an integer; none if it isn't one.
    pub fn int(self, name: str) -> ?int {
        return self.get(name).parseInt()
    }
}

// Percent-decoding for paths, where `+` stands for itself; malformed escapes
// are kept as they are.
fn decodePath(s: str) -> String {
    let b = s.bytes()
    var out = Vec[byte]{}
    var i = 0
    while i < b.len() {
        if b[i] == 37 && i + 2 < b.len() {
            let v = hexValue(s[i + 1..i + 3])
            if v >= 0 {
                out.push(u8(v))
                i += 3
                continue
            }
        }
        out.push(b[i])
        i += 1
    }
    return String(out)
}

// What a handler answers, and what the client gets back. Content-Length and
// Connection are set by the server; line breaks in header names and values
// become spaces.
pub struct Response {
    pub status: int = 200
    pub headers: Vec[Header] = []
    pub body: Vec[byte] = []

    // The value of header `name` (any case).
    pub fn header(self, name: str) -> ?String {
        return findHeader(self.headers, name)
    }

    // Adds a header.
    pub fn setHeader(inout self, name: str, value: str) {
        self.headers.push(Header{name: name.toString(), value: value.toString()})
    }

    // The body, as a string.
    pub fn text(self) -> String {
        return String(self.body.clone())
    }
}

// A plain-text response.
pub fn text(status: int, body: str) -> Response {
    var r = Response{status: status, body: body.bytes().toVec()}
    r.setHeader("Content-Type", "text/plain; charset=utf-8")
    return r
}

// A JSON response; `body` is JSON text (see json.Value.encode).
pub fn json(status: int, body: str) -> Response {
    var r = Response{status: status, body: body.bytes().toVec()}
    r.setHeader("Content-Type", "application/json")
    return r
}

// The reason phrase for a status code: 404 -> "Not Found".
pub fn statusText(status: int) -> str {
    return match status {
        200 => "OK"
        201 => "Created"
        204 => "No Content"
        301 => "Moved Permanently"
        302 => "Found"
        304 => "Not Modified"
        400 => "Bad Request"
        401 => "Unauthorized"
        403 => "Forbidden"
        404 => "Not Found"
        405 => "Method Not Allowed"
        409 => "Conflict"
        411 => "Length Required"
        413 => "Content Too Large"
        422 => "Unprocessable Content"
        431 => "Request Header Fields Too Large"
        500 => "Internal Server Error"
        501 => "Not Implemented"
        503 => "Service Unavailable"
        504 => "Gateway Timeout"
        _ => "Unknown"
    }
}

// Answers requests. `serve` runs in a goroutine of its own for each
// connection, under the deadline of `Options.deadline`; it is cancelled when
// the deadline passes, the client hangs up or the server stops.
pub interface Handler {
    fn serve(self, req: Request) -> Response
}

// How the server treats requests.
pub struct Options {
    // how long a handler may run
    pub deadline: int = 30 * time.second
    // the largest request body accepted
    pub maxBody: int = 8 * 1024 * 1024
    // whether a connection may carry more than one request (HTTP keep-alive)
    pub keepAlive: bool = true
    // how long a connection may wait for its next request before it is closed
    pub idleTimeout: int = 60 * time.second
}

// What happened to the requests a server has handled (see `serveCounting`):
// answered, stopped at the deadline (answered 504), abandoned by the client,
// cancelled when the server stopped, or rejected as malformed or too large.
pub struct Stats {
    pub served: int = 0
    pub timedOut: int = 0
    pub hungUp: int = 0
    pub stopped: int = 0
    pub rejected: int = 0
}

enum Outcome { Served, TimedOut, HungUp, Stopped, Rejected }

// ---------------------------------------------------------------- reading messages

fn findBytes(b: []byte, pat: str, from: int) -> int {
    let p = pat.bytes()
    var i = from
    while i + p.len() <= b.len() {
        var ok = true
        for j in 0..p.len() {
            if b[i + j] != p[j] {
                ok = false
                break
            }
        }
        if ok {
            return i
        }
        i += 1
    }
    return -1
}

fn hexValue(s: str) -> int {
    var v = 0
    if s.len() == 0 || s.len() > 15 {
        return -1
    }
    for r in s.runes() {
        let d = if r >= '0' && r <= '9' { int(r) - 48 } else if r >= 'a' && r <= 'f' { int(r) - 87 } else if r >= 'A' && r <= 'F' { int(r) - 55 } else { -1 }
        if d < 0 {
            return -1
        }
        v = v * 16 + d
    }
    return v
}

// Reads from `c` into `buf` until it holds `n` bytes; false if the peer closed first.
fn fillTo(c: Stream, buf: inout Vec[byte], n: int) -> bool {
    while buf.len() < n{
        let got = c.read(&buf, 65536) catch _e { 0 }
        if got == 0 {
            return false
        }
    }
    return true
}

// The head ("METHOD /path HTTP/1.1" or "HTTP/1.1 200 OK", then headers) up to
// the blank line, and where the body starts. -1: closed; -2: too big.
fn readHead(c: Stream, buf: inout Vec[byte]) -> int {
    var from = 0
    loop {
        let at = findBytes(buf, "\r\n\r\n", from)
        if at > 65536 {
            return -2
        }
        if at >= 0 {
            return at + 4
        }
        if buf.len() > 65536 {
            return -2
        }
        from = if buf.len() > 3 { buf.len() - 3 } else { 0 }
        let got = c.read(&buf, 65536) catch _e { 0 }
        if got == 0 {
            return -1
        }
    }
}

fn parseHeaders(lines: []String) -> Vec[Header] {
    var hs = Vec[Header]{}
    for l in lines {
        if let colon = l.find(":") {
            hs.push(Header{name: l[0..colon].trim().toString(), value: l[colon + 1..].trim().toString()})
        }
    }
    return hs
}

// The body after the head at `start`; `end` is set to where the message ends
// in `buf` (what follows is the next message). Err: the status to answer with.
fn readBody(c: Stream, buf: inout Vec[byte], start: int, hs: []Header, max: int, end: inout int) -> Vec[byte] ! int {
    if let te = findHeader(hs, "Transfer-Encoding") {
        if te.toLower() != "chunked" {
            return err(501)
        }
        var out = Vec[byte]{}
        var pos = start
        loop {
            var eol = findBytes(buf, "\r\n", pos)
            while eol < 0 {
                if buf.len() - pos > 1024 || !fillTo(c, &buf, buf.len() + 1) {
                    return err(400)
                }
                eol = findBytes(buf, "\r\n", pos)
            }
            let sizeLine = String(buf[pos..eol].toVec())
            let size = hexValue((sizeLine.split(";")[0]).trim())
            if size < 0 {
                return err(400)
            }
            if out.len() + size > max {
                return err(413)
            }
            pos = eol + 2
            if size == 0 {
                // trailer lines, then the blank line
                loop {
                    var tl = findBytes(buf, "\r\n", pos)
                    while tl < 0 {
                        if buf.len() - pos > 8192 || !fillTo(c, &buf, buf.len() + 1) {
                            return err(400)
                        }
                        tl = findBytes(buf, "\r\n", pos)
                    }
                    if tl == pos {
                        end = pos + 2
                        return out
                    }
                    pos = tl + 2
                }
            }
            if !fillTo(c, &buf, pos + size + 2) {
                return err(400)
            }
            out.extendFromSlice(buf[pos..pos + size])
            pos += size + 2
        }
    }
    let len = (findHeader(hs, "Content-Length") ?? "0").parseInt() ?? -1
    if len < 0 {
        return err(400)
    }
    if len > max {
        return err(413)
    }
    if !fillTo(c, &buf, start + len) {
        return err(400)
    }
    end = start + len
    return buf[start..start + len].toVec()
}

// The next request on `c`, and whether the client wants the connection kept
// for another one. `buf` holds what was read past the previous request and is
// left holding what follows this one. Err: the status to answer with, or 0
// when the client went away.
fn readRequest(c: Stream, buf: inout Vec[byte], max: int) -> (Request, bool) ! int {
    let start = readHead(c, &buf)
    if start == -1 {
        return err(0)
    }
    if start == -2 {
        return err(431)
    }
    let head = String(buf[0..start - 4].toVec())
    let lines = head.split("\r\n")
    let parts = lines[0].split(" ")
    if parts.len() != 3 || !parts[2].startsWith("HTTP/1.") {
        return err(400)
    }
    let hs = parseHeaders(lines[1..])
    var end = 0
    let body = try readBody(c, &buf, start, hs, max, &end)
    _ = buf.drain(0, end)
    // HTTP/1.1 keeps the connection unless told otherwise; 1.0 only when asked
    let conn = (findHeader(hs, "Connection") ?? "").toLower()
    let keep = if parts[2] == "HTTP/1.0" { conn.contains("keep-alive") } else { !conn.contains("close") }
    let target = parts[1].clone()
    var path = target.clone()
    var q: String = ""
    if let i = target.find("?") {
        path = target[0..i].toString()
        q = target[i + 1..].toString()
    }
    return (Request{method: parts[0].clone(), path: path, rawQuery: q, headers: hs, body: body}, keep)
}

// `s` with line breaks made spaces: a header set from user input can't end
// the header early and add others ("response splitting").
fn oneLine(s: str) -> String {
    if !s.contains("\r") && !s.contains("\n") {
        return s.toString()
    }
    return s.replace("\r", " ").replace("\n", " ")
}

// Whether `s` can be part of a request line or header as it is.
fn safeInHead(s: str) -> bool {
    for b in s.bytes() {
        if b == 13 || b == 10 || b == 0 {
            return false
        }
    }
    return true
}

// Writes `r`; `withBody` is false for an answer to HEAD. False if the write
// failed.
fn writeResponse(c: Stream, r: Response, keep: bool, withBody: bool) -> bool {
    var head = fmt.format("HTTP/1.1 {} {}\r\n", r.status, statusText(r.status))
    for h in r.headers {
        if h.name.toLower() != "content-length" && h.name.toLower() != "connection" {
            head.push(fmt.format("{}: {}\r\n", oneLine(h.name), oneLine(h.value)))
        }
    }
    head.push(fmt.format("Content-Length: {}\r\nConnection: {}\r\n\r\n", r.body.len(), if keep { "keep-alive" } else { "close" }))
    // small answers go out in one write
    if withBody && r.body.len() <= 16384 {
        var all = head.bytes().toVec()
        all.extendFromSlice(r.body)
        return c.write(all).isOk()
    }
    if c.writeText(head).isErr() {
        return false
    }
    return !withBody || c.write(r.body).isOk()
}

// ---------------------------------------------------------------- serving

// Serves the requests on one connection, one after another, while the client
// keeps it open (keep-alive) and sends the next within `opts.idleTimeout`.
fn serveConn[H: Handler + send](c: Stream, h: H, opts: Options, stats: Mutex[Stats]) {
    var buf = Vec[byte]{}
    var first = true
    loop {
        // wait for the next request, but not forever
        if buf.len() == 0 {
            let got = task.timeout(opts.idleTimeout, () => c.read(&buf, 65536) catch _e { 0 }) ?? 0
            if got == 0 {
                // a client that hung up before asking anything
                if first && !task.cancelled() {
                    count(stats, .HungUp)
                }
                return
            }
        }
        first = false
        let (o, keep) = handleOne(c, &buf, h, opts)
        count(stats, o)
        if !keep || task.cancelled() {
            return
        }
    }
}

// Reads, handles and answers one request; whether the connection can carry
// another.
fn handleOne[H: Handler + send](c: Stream, buf: inout Vec[byte], h: H, opts: Options) -> (Outcome, bool) {
    let (req, wantsKeep) = readRequest(c, &buf, opts.maxBody) catch status {
        if task.cancelled() {
            return (.Stopped, false)
        }
        if status == 0 {
            return (.HungUp, false)
        }
        // what follows a malformed request can't be trusted: close
        _ = writeResponse(c, text(status, statusText(status)), false, true)
        return (.Rejected, false)
    }
    if task.cancelled() {
        _ = writeResponse(c, stopping(), false, true)
        return (.Stopped, false)
    }
    // the watcher and the handler each write their own variable
    var result = Response{status: 0}
    var hungUp = false
    var early = Vec[byte]{}
    scope s {
        // the watcher: a read that returns 0 means the client hung up. Bytes it
        // gets are the start of the next request (pipelining): they are kept.
        go () => {
            let n = c.read(&early, 1) catch _e { -1 }
            if n == 0 && !task.cancelled() {
                hungUp = true
                s.cancel()
            }
        }
        // the handler, in the body (s.cancel() cancels it too, so no task of
        // its own), under the deadline; when done it stops the watcher
        if let r = task.timeout(opts.deadline, () => h.serve(req)) {
            result = r
        }
        s.cancel()
    }
    if hungUp {
        return (.HungUp, false)
    }
    // the server is stopping: drop the request, and say so (a client must
    // not take the closed connection for a stale one and send it again)
    if task.cancelled() {
        _ = writeResponse(c, stopping(), false, true)
        return (.Stopped, false)
    }
    buf.extend(early)
    let timedOut = result.status == 0
    if timedOut {
        result = text(504, "the request took too long\n")
    }
    let keep = wantsKeep && opts.keepAlive && (result.header("Connection") ?? "").toLower() != "close"
    if !writeResponse(c, result, keep, req.method != "HEAD") {
        return (.HungUp, false)
    }
    return (if timedOut { .TimedOut } else { .Served }, keep)
}

// Serves until the calling task is cancelled; then cancels the requests in
// flight and waits for them.
pub fn serve[H: Handler + send](ln: net.Listener, h: H, opts: Options) {
    let stats = Mutex(Stats{})
    serveCounting(ln, h, opts, stats)
}

// Like `serve`, counting what happened to the requests in `stats`.
pub fn serveCounting[H: Handler + send](ln: net.Listener, h: H, opts: Options, stats: Mutex[Stats]) {
    scope {
        loop {
            let c = ln.accept() catch _e {
                break
            }
            // `c` moves into the task; `h`, `opts` and `stats` are borrowed
            go serveConn(Stream.Plain(c), h, opts, stats)
        }
    }
}

// Serves HTTPS, as `serve` serves HTTP: `ln` from
// `tls.listen(":8443", "cert.pem", "key.pem")`. Each connection's TLS
// handshake runs in its own task.
pub fn serveTls[H: Handler + send](ln: tls.Listener, h: H, opts: Options) {
    let stats = Mutex(Stats{})
    serveTlsCounting(ln, h, opts, stats)
}

// Like `serveTls`, counting what happened to the requests in `stats`.
pub fn serveTlsCounting[H: Handler + send](ln: tls.Listener, h: H, opts: Options, stats: Mutex[Stats]) {
    scope {
        loop {
            let c = ln.accept() catch _e {
                break
            }
            go serveConn(Stream.Secure(c), h, opts, stats)
        }
    }
}

fn stopping() -> Response {
    var r = text(503, "the server is shutting down\n")
    r.setHeader("Retry-After", "1")
    return r
}

fn count(stats: Mutex[Stats], o: Outcome) {
    with s = stats.lock() {
        match o {
            .Served => s.served += 1
            .TimedOut => s.timedOut += 1
            .HungUp => s.hungUp += 1
            .Stopped => s.stopped += 1
            .Rejected => s.rejected += 1
        }
    }
}

// ---------------------------------------------------------------- the client

fn badUrl(url: str, why: str) -> io.Error {
    return io.newError(.InvalidInput, fmt.format("bad URL `{}`: {}", url, why))
}

// Sends a request and reads the whole response. `url` is
// "http://host[:port]/path?query" or "https://...", whose server certificate
// is checked against the system's roots. Connections are kept and reused by
// later requests to the same server (for a few seconds); a `Connection: close`
// header opts out.
pub fn request(method: str, url: str, headers: []Header, body: []byte) -> Response ! io.Error {
    let secure = url.startsWith("https://")
    if !secure && !url.startsWith("http://") {
        return err(badUrl(url, "expected http:// or https://"))
    }
    let rest = url[if secure { 8 } else { 7 }..]
    let slash = rest.find("/") ?? rest.len()
    let hostPort = rest[0..slash]
    let target = if slash < rest.len() { rest[slash..].toString() } else { "/" }
    if hostPort.len() == 0 {
        return err(badUrl(url, "no host"))
    }
    if !safeInHead(url) || target.contains(" ") {
        return err(badUrl(url, "spaces and control characters must be percent-encoded"))
    }
    if method.len() == 0 || method.contains(" ") || !safeInHead(method) {
        return err(io.newError(.InvalidInput, fmt.format("bad HTTP method `{}`: it is one word", oneLine(method))))
    }
    for h in headers {
        if h.name.len() == 0 || h.name.contains(":") || h.name.contains(" ") || !safeInHead(h.name) || !safeInHead(h.value) {
            return err(io.newError(.InvalidInput, fmt.format("bad header `{}`: a name is one word without `:`, and neither names nor values may hold line breaks", oneLine(h.name))))
        }
    }
    let hasPort = if hostPort.startsWith("[") { hostPort.contains("]:") } else { hostPort.contains(":") }
    let addr = if hasPort { hostPort.toString() } else { hostPort + if secure { ":443" } else { ":80" } }
    var head = fmt.format("{} {} HTTP/1.1\r\nHost: {}\r\nContent-Length: {}\r\n", method, target, hostPort, body.len())
    for h in headers {
        head.push(fmt.format("{}: {}\r\n", h.name, h.value))
    }
    head.push("\r\n")
    let key = (if secure { "https://" } else { "http://" }) + addr
    let pooled = !(findHeader(headers, "Connection") ?? "").toLower().contains("close")
    let noBody = method == "HEAD"
    // a kept connection first; the server may have closed it meanwhile, so a
    // request that can safely be sent twice gets a second try on a new one
    if pooled {
        if let c = takeIdle(key) {
            match exchange(c, head, body, noBody) {
                ok(got) => {
                    let (resp, keep) = got
                    if keep {
                        putIdle(key, c)
                    }
                    return resp
                }
                err(f) => {
                    match f {
                        Stale(e) => {
                            if !idempotent(method) {
                                return err(e.clone())
                            }
                        }
                        Broken(e) => return err(e.clone())
                    }
                }
            }
        }
    }
    let c = if secure { Stream.Secure(try tls.dial(addr)) } else { Stream.Plain(try net.dial(addr)) }
    match exchange(c, head, body, noBody) {
        ok(got) => {
            let (resp, keep) = got
            if keep && pooled {
                putIdle(key, c)
            }
            return resp
        }
        err(f) => {
            return err(match f {
                Stale(e) => e.clone()
                Broken(e) => e.clone()
            })
        }
    }
}

fn idempotent(method: str) -> bool {
    return method == "GET" || method == "HEAD" || method == "OPTIONS" || method == "PUT" || method == "DELETE" || method == "TRACE"
}

// How an exchange failed: Stale when nothing came back (the server may have
// closed a kept connection), Broken otherwise.
enum Fail {
    Stale(io.Error)
    Broken(io.Error)
}

// Sends one request on `c` and reads the response; whether `c` can carry
// another request.
fn exchange(c: Stream, head: str, body: []byte, noBody: bool) -> (Response, bool) ! Fail {
    var msg = head.bytes().toVec()
    msg.extendFromSlice(body)
    c.write(msg) catch e {
        return err(.Stale(e))
    }
    var buf = Vec[byte]{}
    let start = readHead(c, &buf)
    if start == -1 {
        let e = io.newError(.UnexpectedEof, "the server closed the connection without answering")
        return err(if buf.len() == 0 { .Stale(e) } else { .Broken(e) })
    }
    if start < 0 {
        return err(.Broken(io.newError(.InvalidInput, "the response head is over 64 KiB")))
    }
    let lines = String(buf[0..start - 4].toVec()).split("\r\n")
    let parts = lines[0].split(" ")
    let status = if parts.len() >= 2 { parts[1].parseInt() ?? 0 } else { 0 }
    if status == 0 {
        return err(.Broken(io.newError(.InvalidInput, "not an HTTP response: " + lines[0])))
    }
    let hs = parseHeaders(lines[1..])
    let conn = (findHeader(hs, "Connection") ?? "").toLower()
    var keep = if parts[0] == "HTTP/1.0" { conn.contains("keep-alive") } else { !conn.contains("close") }
    var b = Vec[byte]{}
    if noBody || status < 200 || status == 204 || status == 304 {
        keep = keep && buf.len() == start
    } else if findHeader(hs, "Content-Length") != none || findHeader(hs, "Transfer-Encoding") != none {
        var end = 0
        b = readBody(c, &buf, start, hs, 1 << 40, &end) catch _status {
            return err(.Broken(io.newError(.UnexpectedEof, "the response body ended early")))
        }
        keep = keep && end == buf.len()
    } else {
        // until the server closes the connection
        loop {
            let n = c.read(&buf, 65536) catch e {
                return err(.Broken(e))
            }
            if n == 0 {
                break
            }
        }
        b = buf[start..].toVec()
        keep = false
    }
    return (Response{status: status, headers: hs, body: b}, keep)
}

// Connections the client keeps for later requests to the same server.
struct IdleConn {
    key: String
    conn: Stream
    since: int
}

let idleConns = Mutex(Vec[IdleConn]{})
const maxIdle = 64
const maxIdlePerServer = 8
// servers commonly close idle connections after 5 to 75 seconds
const idleFor = 4 * 1000000000

fn __readable(fd: int) -> bool

fn rawFd(c: Stream) -> int {
    return match c {
        Plain(p) => p.rawFd()
        Secure(t) => t.rawFd()
    }
}

// A kept connection to `key`, if one is still usable.
fn takeIdle(key: str) -> ?Stream {
    let now = time.now()
    var found: ?Stream = none
    var stale = Vec[IdleConn]{}
    with pool = idleConns.lock() {
        var i = pool.len() - 1
        while i >= 0 {
            if now - pool[i].since > idleFor {
                stale.push(pool.remove(i))
            } else if found == none && pool[i].key == key {
                found = some(pool.remove(i).conn)
            }
            i -= 1
        }
    }
    // a kept connection with something to read has been closed by the server
    // (or is out of step with it): don't use it
    if let c = found {
        if !__readable(rawFd(c)) {
            return some(c)
        }
    }
    return none
}

fn putIdle(key: str, c: sink Stream) {
    var out: ?IdleConn = none
    with pool = idleConns.lock() {
        var same = 0
        for ic in pool {
            if ic.key == key {
                same += 1
            }
        }
        if same < maxIdlePerServer {
            if pool.len() >= maxIdle {
                out = some(pool.remove(0))
            }
            pool.push(IdleConn{key: key.toString(), conn: c, since: time.now()})
        }
    }
}

// A GET request.
pub fn get(url: str) -> Response ! io.Error {
    return request("GET", url, Vec[Header]{}, "".bytes())
}

// A POST request with a body of the given type.
pub fn post(url: str, contentType: str, body: []byte) -> Response ! io.Error {
    return request("POST", url, [Header{name: "Content-Type", value: contentType.toString()}], body)
}

// ---------------------------------------------------------------- URL encoding

// Percent-decoding (and `+` as a space, as in query strings); none if malformed.
pub fn decode(s: str) -> ?String {
    let b = s.bytes()
    var out = Vec[byte]{}
    var i = 0
    while i < b.len() {
        let c = b[i]
        if c == 37 {
            if i + 2 >= b.len() {
                return none
            }
            let v = hexValue(String(b[i + 1..i + 3].toVec()).asStr())
            if v < 0 {
                return none
            }
            out.push(u8(v))
            i += 3
        } else {
            out.push(if c == 43 { 32 } else { c })
            i += 1
        }
    }
    return some(String(out))
}

// Percent-encoding of everything but letters, digits and `-._~`.
pub fn encode(s: str) -> String {
    var out: String = ""
    for c in s.bytes() {
        let plain = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 || c == 126
        if plain {
            out.pushRune(rune(c))
        } else {
            out.push(fmt.format("%{:02X}", c))
        }
    }
    return out
}
