// Files, directories, the environment and processes.
//
//   let text = try os.readText("notes.txt")
//   for name in try os.readDir(".") {
//       println(name)
//   }
//   let r = try os.run("git", ["status", "--short"])
//   print(r.stdout)
use std/io

// Errors here are io.Error (with an io.ErrorKind to match on).
pub type Error = io.Error

fn __readFile(path: str, out: inout Vec[byte]) -> int
fn __writeFile(path: str, data: []byte) -> int
fn __getenv(name: str, out: inout String) -> bool
fn __open(path: str, mode: int) -> int
fn __read(fd: int, buf: inout Vec[byte], max: int) -> int
fn __write(fd: int, data: []byte) -> int
fn __close(fd: int)
fn __flush(fd: int)
fn __stat(path: str, follow: bool, size: inout int, mtime: inout int, kind: inout int, mode: inout int) -> int
fn __readDir(path: str, names: inout Vec[String]) -> int
fn __mkdir(path: str) -> int
fn __remove(path: str) -> int
fn __rename(from: str, to: str) -> int
fn __cwd(out: inout String) -> int
fn __chdir(path: str) -> int
fn __setenv(name: str, value: str, unset: bool) -> int
fn __tempDir(out: inout String)
fn __run(prog: str, args: []String, input: []byte, capture: bool, out: inout Vec[byte], errout: inout Vec[byte], status: inout int) -> int
fn __spawn(prog: str, args: []String, env: []String, setEnv: bool, dir: str, modes: []int, fds: inout Vec[int], pid: inout int) -> int
fn __wait(pid: int) -> int
fn __tryWait(pid: int) -> int
fn __kill(pid: int, sig: int) -> int
fn __environ(out: inout Vec[String])
fn __notify(sigs: []int, fds: inout Vec[int]) -> int
fn __unnotify(sigs: []int, wfd: int)
fn __signalCode(signo: int) -> int
fn __getpid() -> int

fn check(what: str, code: int) ! Error {
    if code != 0 {
        return err(io.fromCode(what, code))
    }
}

// The command line: the program's name, then its arguments.
pub fn args() -> Vec[String]
// Ends the program with an exit code, after flushing standard output. Deferred
// code does not run.
pub fn exit(code: int) -> never

// ---------------------------------------------------------------- files

// An open file. It is closed when it goes out of scope.
pub struct File {
    fd: int
    owned: bool = true

    // Appends at most `max` bytes to `buf`; returns how many, 0 at the end.
    pub fn read(self, buf: inout Vec[byte], max: int) -> int ! Error {
        let n = __read(self.fd, &buf, max)
        if n < 0 {
            return err(io.fromCode("read", -n))
        }
        return n
    }

    // Writes all of `data`.
    pub fn write(self, data: []byte) ! Error {
        let code = __write(self.fd, data)
        if code < 0 {
            return err(io.fromCode("write", -code))
        }
    }

    // Writes the bytes of `s`.
    pub fn writeText(self, s: str) ! Error {
        return self.write(s.bytes())
    }

    // Reads to the end.
    pub fn readAll(self) -> Vec[byte] ! Error {
        var out = Vec[byte]{}
        loop {
            let n = try self.read(&out, 65536)
            if n == 0 {
                return out
            }
        }
    }

    // Reads to the end, as a string.
    pub fn readText(self) -> String ! Error {
        let b = try self.readAll()
        return String(b)
    }

    // Writes out what `print` and the standard streams have buffered.
    pub fn flush(self) {
        __flush(self.fd)
    }

    fn drop(inout self) {
        if self.owned {
            __close(self.fd)
        }
    }
}

fn openMode(path: str, mode: int) -> File ! Error {
    let fd = __open(path, mode)
    if fd < 0 {
        return err(io.fromCode(path, -fd))
    }
    return File{fd: fd}
}

// Opens a file for reading.
pub fn open(path: str) -> File ! Error {
    return openMode(path, 0)
}

// Creates a file for writing, or empties an existing one.
pub fn create(path: str) -> File ! Error {
    return openMode(path, 1)
}

// Opens a file for writing at its end, creating it if needed.
pub fn append(path: str) -> File ! Error {
    return openMode(path, 2)
}

// The standard streams. They are not closed when the `File` is dropped.
pub fn stdin() -> File {
    return File{fd: 0, owned: false}
}
pub fn stdout() -> File {
    return File{fd: 1, owned: false}
}
pub fn stderr() -> File {
    return File{fd: 2, owned: false}
}

// The whole contents of a file.
pub fn readFile(path: str) -> Vec[byte] ! Error {
    var buf = Vec[byte]{}
    let code = __readFile(path, &buf)
    if code != 0 {
        return err(io.fromCode(path, code))
    }
    return buf
}

// The whole contents of a file, as a string (the bytes aren't checked to be
// UTF-8).
pub fn readText(path: str) -> String ! Error {
    let b = try readFile(path)
    return String(b)
}

// Creates or replaces a file with `data`. Not atomic: write to a temporary
// name and `rename` it into place for that.
pub fn writeFile(path: str, data: []byte) ! Error {
    return check(path, __writeFile(path, data))
}

// Creates or replaces a file with the bytes of `text`.
pub fn writeText(path: str, text: str) ! Error {
    return writeFile(path, text.bytes())
}

// ---------------------------------------------------------------- the file system

// What a path names. (`Other`: a device, socket or pipe.)
pub copy enum FileKind { File, Directory, Symlink, Other }

// What `stat` reports about a file.
pub struct Info {
    pub kind: FileKind
    pub size: int
    // last modification, in nanoseconds since 1970 (`time.local(info.modified)`)
    pub modified: int
    // permission bits, like 0o644
    pub mode: int

    // Whether it is a directory.
    pub fn isDir(self) -> bool {
        return self.kind == .Directory
    }

    // Whether it is a regular file.
    pub fn isFile(self) -> bool {
        return self.kind == .File
    }
}

fn statWith(path: str, follow: bool) -> Info ! Error {
    var size = 0
    var mtime = 0
    var kind = 0
    var mode = 0
    try check(path, __stat(path, follow, &size, &mtime, &kind, &mode))
    let k: FileKind = match kind {
        0 => .File
        1 => .Directory
        2 => .Symlink
        _ => .Other
    }
    return Info{kind: k, size: size, modified: mtime, mode: mode}
}

// What `path` is; follows symbolic links.
pub fn stat(path: str) -> Info ! Error {
    return statWith(path, true)
}

// Like `stat`, but describes a symbolic link itself.
pub fn lstat(path: str) -> Info ! Error {
    return statWith(path, false)
}

// Whether `path` names something (following symbolic links). To act on a
// file, just try it and handle the error: it may change in between.
pub fn exists(path: str) -> bool {
    return stat(path).isOk()
}

// The names of the entries in a directory, sorted.
pub fn readDir(path: str) -> Vec[String] ! Error {
    var names = Vec[String]{}
    try check(path, __readDir(path, &names))
    return names
}

// Creates a directory; fails if it exists or its parent doesn't.
pub fn mkdir(path: str) ! Error {
    return check(path, __mkdir(path))
}

// Creates a directory and any missing parents; fine if it exists already.
pub fn mkdirAll(path: str) ! Error {
    if let info = stat(path).ok() {
        if info.isDir() {
            return
        }
        return err(io.newError(.AlreadyExists, path + ": exists and is not a directory"))
    }
    let parent = dirName(path)
    if parent != path && parent.len() > 0 {
        try mkdirAll(parent)
    }
    let code = __mkdir(path)
    if code != 0 {
        // made by someone else in the meantime is fine
        if let info = stat(path).ok() {
            if info.isDir() {
                return
            }
        }
        return err(io.fromCode(path, code))
    }
}

// Removes a file or an empty directory.
pub fn remove(path: str) ! Error {
    return check(path, __remove(path))
}

// Removes a file, or a directory and everything in it. Symbolic links are
// removed, not followed.
pub fn removeAll(path: str) ! Error {
    let info = lstat(path) catch e {
        if e.isNotFound() {
            return
        }
        return err(e)
    }
    if info.isDir() {
        for name in try readDir(path) {
            try removeAll(joinPath(path, name))
        }
    }
    return remove(path)
}

// Renames or moves a file or directory, replacing `to` if it is a file. Both
// must be on the same file system.
pub fn rename(from: str, to: str) ! Error {
    return check(from, __rename(from, to))
}

// The working directory.
pub fn cwd() -> String ! Error {
    var out: String = ""
    try check("getcwd", __cwd(&out))
    return out
}

// Changes the working directory, for the whole process.
pub fn chdir(path: str) ! Error {
    return check(path, __chdir(path))
}

// The directory for temporary files ($TMPDIR, or /tmp).
pub fn tempDir() -> String {
    var out: String = ""
    __tempDir(&out)
    return out
}

// "a/b" + "c" = "a/b/c".
pub fn joinPath(a: str, b: str) -> String {
    if a.len() == 0 || b.startsWith("/") {
        return b.toString()
    }
    if a.endsWith("/") {
        return a + b
    }
    return a + "/" + b
}

// The directory part of a path: "a/b/c" -> "a/b", "c" -> ".", "/c" -> "/".
pub fn dirName(path: str) -> String {
    var end = path.len()
    while end > 1 && path[end - 1..end] == "/" {
        end -= 1
    }
    var i = end - 1
    while i >= 0 && path[i..i + 1] != "/" {
        i -= 1
    }
    if i < 0 {
        return "."
    }
    if i == 0 {
        return "/"
    }
    return path[0..i].toString()
}

// The last part of a path: "a/b/c.txt" -> "c.txt".
pub fn baseName(path: str) -> String {
    var end = path.len()
    while end > 1 && path[end - 1..end] == "/" {
        end -= 1
    }
    var i = end - 1
    while i >= 0 && path[i..i + 1] != "/" {
        i -= 1
    }
    return path[i + 1..end].toString()
}

// ---------------------------------------------------------------- the environment

// The value of an environment variable.
pub fn getenv(name: str) -> ?String {
    var out: String = ""
    if __getenv(name, &out) {
        return out
    }
    return none
}

// Sets an environment variable, for this process and the programs it starts.
pub fn setenv(name: str, value: str) ! Error {
    return check(name, __setenv(name, value, false))
}

// Removes an environment variable.
pub fn unsetenv(name: str) ! Error {
    return check(name, __setenv(name, "", true))
}

// ---------------------------------------------------------------- processes

// What a finished process printed, and how it ended.
pub struct Output {
    // the exit code, or 128 + the signal that ended it
    pub status: int
    pub stdout: String
    pub stderr: String

    // Whether the process exited with status 0.
    pub fn ok(self) -> bool {
        return self.status == 0
    }
}

// Runs a program (looked up in $PATH) and waits for it, collecting what it
// prints. Fails only if it can't be started: check `status` for how it ended.
pub fn run(prog: str, args: []String) -> Output ! Error {
    return runWithInput(prog, args, "")
}

// Like `run`, with `input` as the program's standard input.
pub fn runWithInput(prog: str, args: []String, input: str) -> Output ! Error {
    var out = Vec[byte]{}
    var errout = Vec[byte]{}
    var status = 0
    try check(prog, __run(prog, args, input.bytes(), true, &out, &errout, &status))
    return Output{status: status, stdout: String(out), stderr: String(errout)}
}

// Runs a program on this process's standard streams and returns its exit code.
pub fn call(prog: str, args: []String) -> int ! Error {
    var out = Vec[byte]{}
    var errout = Vec[byte]{}
    var status = 0
    try check(prog, __run(prog, args, "".bytes(), false, &out, &errout, &status))
    return status
}

// This process's ID.
pub fn pid() -> int {
    return __getpid()
}

// The environment variables of this process, as (name, value) pairs.
pub fn environ() -> Vec[(String, String)] {
    var all = Vec[String]{}
    __environ(&all)
    var out = Vec[(String, String)]{}
    for kv in all {
        if let (k, v) = kv.splitOnce("=") {
            out.push((k.toString(), v.toString()))
        }
    }
    return out
}

// How a child's standard stream is set up.
pub copy enum Stdio {
    // this process's own stream
    Inherit
    // a pipe: the `Process` holds the other end as a `File`
    Pipe
    // nothing: reads see the end at once, writes go nowhere
    Null
    // for stderr: wherever stdout goes (`2>&1`)
    Stdout
}

// A program to start, and how: build one with `command`, adjust it, then
// `start`, `run` or `output` it (as often as needed).
//
//   var c = os.command("git", ["log", "--oneline"])
//   c.dir("/src/app")
//   c.env("GIT_PAGER", "cat")
//   let out = try c.output()          // waits; out.stdout, out.status
//
//   var sort = os.command("sort", [])
//   sort.stdin = .Pipe
//   sort.stdout = .Pipe
//   var p = try sort.start()
//   if let w = p.stdin { try w.writeText("b\na\n") }
//   p.stdin = none                    // closes it: sort sees the end
//   let sorted = try p.stdout?.readText()
//   let status = try p.wait()
pub struct Command {
    prog: String
    args: Vec[String]
    // changes to the environment, in order; none removes the variable
    envs: Vec[(String, ?String)] = Vec[(String, ?String)]{}
    cleared: bool = false
    workDir: String = ""
    pub stdin: Stdio = .Inherit
    pub stdout: Stdio = .Inherit
    pub stderr: Stdio = .Inherit

    // Adds an argument.
    pub fn arg(inout self, a: str) {
        self.args.push(a.toString())
    }

    // Sets an environment variable for the child.
    pub fn env(inout self, name: str, value: str) {
        self.envs.push((name.toString(), some(value.toString())))
    }

    // Removes an environment variable for the child.
    pub fn unsetEnv(inout self, name: str) {
        self.envs.push((name.toString(), none))
    }

    // Starts the child with no environment variables but those set with
    // `env`.
    pub fn clearEnv(inout self) {
        self.cleared = true
        self.envs.clear()
    }

    // Runs the child in directory `path`.
    pub fn dir(inout self, path: str) {
        self.workDir = path.toString()
    }

    // Starts the child without waiting for it.
    pub fn start(self) -> Process ! Error {
        var env = Vec[String]{}
        let setEnv = self.cleared || !self.envs.isEmpty()
        if setEnv {
            var vars = Map[String, String]{}
            if !self.cleared {
                for kv in environ() {
                    vars[kv.0.clone()] = kv.1.clone()
                }
            }
            for e in self.envs {
                if let v = e.1 {
                    vars[e.0.clone()] = v.clone()
                } else {
                    _ = vars.remove(e.0.clone())
                }
            }
            for k, v in vars {
                env.push("${k}=${v}")
            }
        }
        let modes = [int(self.stdin), int(self.stdout), int(self.stderr)]
        if self.stdin == Stdio.Stdout || self.stdout == Stdio.Stdout {
            panic("os: only stderr can go where stdout goes")
        }
        var fds = Vec[int]{}
        var pid = 0
        try check(self.prog, __spawn(self.prog, self.args, env, setEnv, self.workDir, modes, &fds, &pid))
        return Process{pid, stdin: pipeEnd(fds[0]), stdout: pipeEnd(fds[1]), stderr: pipeEnd(fds[2])}
    }

    // Starts the child and waits for it: its status (the exit code, or 128 +
    // the signal that ended it).
    pub fn run(self) -> int ! Error {
        var p = try self.start()
        return try p.wait()
    }

    // Starts the child with its output piped (unless set otherwise), and
    // waits for it, collecting what it prints. Stdin is empty unless set.
    pub fn output(self) -> Output ! Error {
        var c = self.clone()
        if c.stdin == Stdio.Inherit {
            c.stdin = .Null
        }
        c.stdout = .Pipe
        if c.stderr != Stdio.Stdout {
            c.stderr = .Pipe
        }
        var p = try c.start()
        var out = Vec[byte]{}
        var errout = Vec[byte]{}
        // both at once, so that neither pipe fills up and stalls the child
        try scope {
            go () => {
                if let f = p.stderr {
                    errout = try f.readAll()
                }
            }
            if let f = p.stdout {
                out = try f.readAll()
            }
        }
        let status = try p.wait()
        return Output{status, stdout: String(out), stderr: String(errout)}
    }
}

fn pipeEnd(fd: int) -> ?File {
    if fd < 0 {
        return none
    }
    return File{fd}
}

// A program to run, with these arguments (looked up in $PATH unless it holds
// a `/`). Its standard streams are this process's unless set otherwise.
pub fn command(prog: str, args: []String) -> Command {
    return Command{prog: prog.toString(), args: args.toVec()}
}

// A started child process. Its pipe ends close when they are dropped (set
// `stdin` to none to let the child see the end of its input). Wait for it:
// a child that is dropped while still running is left running.
pub struct Process {
    pid: int
    pub stdin: ?File
    pub stdout: ?File
    pub stderr: ?File
    status: ?int

    // The process ID.
    pub fn id(self) -> int {
        return self.pid
    }

    // Closes stdin, then waits for the child to end: its status (the exit
    // code, or 128 + the signal that ended it). Cancelling the task stops
    // the wait (`isCancelled()`), not the child.
    pub fn wait(inout self) -> int ! Error {
        if let st = self.status {
            return st
        }
        self.stdin = none
        let st = __wait(self.pid)
        if st < 0 {
            return err(io.fromCode("wait", -st))
        }
        self.status = st
        return st
    }

    // The status if the child has ended, without waiting.
    pub fn tryWait(inout self) -> ?int {
        if self.status == none {
            let st = __tryWait(self.pid)
            if st >= 0 {
                self.status = st
            }
        }
        return self.status
    }

    // Sends the child a signal (`.Term` asks it to stop).
    pub fn signal(self, sig: Signal) ! Error {
        if self.status != none {
            return
        }
        try check("kill", __kill(self.pid, int(sig)))
    }

    // Ends the child at once (SIGKILL); wait for it afterwards.
    pub fn kill(self) ! Error {
        return self.signal(.Kill)
    }

    fn drop(inout self) {
        // reap it if it is done already, so it doesn't linger as a zombie
        _ = self.tryWait()
    }
}

// The POSIX signals, by name.
pub copy enum Signal {
    Hup
    Int
    Quit
    Kill
    Term
    Usr1
    Usr2
    Winch
    Pipe
    Alrm
    Chld
    Cont
    Stop
    Tstp
}

// Starts listening for these signals: each one that arrives is delivered to
// `Signals.next` instead of having its usual effect. Ctrl-C (`.Int`) and
// `.Term` then no longer shut the program down; when the `Signals` is
// dropped, they do again.
//
//   var sigs = try os.notify([.Hup, .Term])
//   loop {
//       match try sigs.next() {
//           .Hup => reload()
//           _ => break
//       }
//   }
pub fn notify(sigs: []Signal) -> Signals ! Error {
    var codes = Vec[int]{}
    for s in sigs {
        if s == Signal.Kill || s == Signal.Stop {
            panic("os.notify: SIGKILL and SIGSTOP can't be caught")
        }
        codes.push(int(s))
    }
    var fds = Vec[int]{}
    let e = __notify(codes, &fds)
    if e != 0 {
        if fds.len() == 2 {
            __unnotify(codes, fds[1])
            drop(File{fd: fds[0]})
        }
        return err(io.fromCode("notify", e))
    }
    return Signals{codes, r: File{fd: fds[0]}, w: fds[1]}
}

// Signals as they arrive; see `notify`.
pub struct Signals {
    codes: Vec[int]
    r: File
    w: int

    // Waits for the next signal. Cancelling the task stops the wait.
    pub fn next(self) -> Signal ! Error {
        var b = Vec[byte]{}
        loop {
            b.clear()
            let n = try self.r.read(&b, 1)
            if n == 1 {
                let code = __signalCode(int(b[0]))
                if code >= 0 {
                    return signalOf(code)
                }
            }
        }
    }

    fn drop(inout self) {
        __unnotify(self.codes, self.w)
    }
}

fn signalOf(code: int) -> Signal {
    let all = [Signal.Hup, .Int, .Quit, .Kill, .Term, .Usr1, .Usr2, .Winch, .Pipe, .Alrm, .Chld, .Cont, .Stop, .Tstp]
    return all[code]
}

// What `walk` does after visiting a path.
pub copy enum Walk {
    // go on (into it, for a directory)
    Continue
    // don't go into this directory
    SkipDir
    // stop the walk
    Stop
}

// Visits `root` and everything below it, depth first, a directory's entries
// in name order after the directory itself. Symbolic links are visited, not
// followed. An entry that can't be read ends the walk with its error.
//
//   try os.walk("src", (p, info) => {
//       if info.isDir() && os.baseName(p) == ".git" { return .SkipDir }
//       if p.endsWith(".gojo") { files.push(p.toString()) }
//       return .Continue
//   })
pub fn walk(root: str, visit: fn(str, Info) -> Walk) ! Error {
    _ = try walkIn(root, visit)
}

// false when the walk stops
fn walkIn(path: str, visit: fn(str, Info) -> Walk) -> bool ! Error {
    let info = try lstat(path)
    match visit(path, info) {
        .Stop => return false
        .SkipDir => return true
        .Continue => {}
    }
    if info.isDir() {
        for name in try readDir(path) {
            if !(try walkIn(joinPath(path, name), visit)) {
                return false
            }
        }
    }
    return true
}
