// URLs (RFC 3986): parsing them into their parts and back, query strings,
// and percent-encoding.
//
//   let u = try url.parse("https://ann@example.com:8080/a%20b?q=1&q=2#top")
//   // u.scheme "https", u.user some("ann"), u.host "example.com",
//   // u.port some(8080), u.path "/a b", u.fragment "top"
//   u.query().getAll("q")                 // ["1", "2"]
//
//   var q = url.Query{}
//   q.add("name", "Ann Lee")
//   q.encode()                            // "name=Ann+Lee"

// A URL that can't be parsed.
pub struct Error {
    pub msg: String

    pub fn message(self) -> String {
        return "url: ${self.msg}"
    }
}

fn __escape(s: str, mode: int) -> String
fn __unescape(s: str, plus: bool, lenient: bool, out: inout String) -> bool

// A URL taken apart. `path`, `user` and `fragment` are decoded; `rawQuery`
// is kept as written (decode it with `query()`).
pub struct Url {
    // in lower case: "https"
    pub scheme: String = ""
    // "user" or "user:password"
    pub user: ?String
    // a name or an address; an IPv6 address without its brackets
    pub host: String = ""
    pub port: ?int
    pub path: String = ""
    // after the `?`
    pub rawQuery: String = ""
    // after the `#`
    pub fragment: String = ""

    // The query string's parameters.
    pub fn query(self) -> Query {
        return parseQuery(self.rawQuery)
    }

    // The URL as text again, with its parts escaped as needed.
    pub fn toString(self) -> String {
        var out: String = ""
        if self.scheme.len() > 0 {
            out.push(self.scheme)
            out.push(":")
        }
        if self.host.len() > 0 || self.user.isSome() {
            out.push("//")
            if let u = self.user {
                out.push(__escape(u, 3))
                out.push("@")
            }
            if self.host.contains(":") {
                out.push("[${self.host}]")
            } else {
                out.push(self.host)
            }
            if let p = self.port {
                out.push(":${p}")
            }
            if self.path.len() > 0 && !self.path.startsWith("/") {
                out.push("/")
            }
        }
        out.push(__escape(self.path, 2))
        if self.rawQuery.len() > 0 {
            out.push("?")
            out.push(self.rawQuery)
        }
        if self.fragment.len() > 0 {
            out.push("#")
            out.push(__escape(self.fragment, 2))
        }
        return out
    }

    // `ref` resolved against this URL, as a browser follows a link:
    // `"https://a.com/x/y".resolve("../z")` is `https://a.com/z`.
    pub fn resolve(self, ref: str) -> Url ! Error {
        var r = try parse(ref)
        if r.scheme.len() > 0 {
            r.path = removeDots(r.path)
            return r
        }
        r.scheme = self.scheme.clone()
        if r.host.len() > 0 || r.user.isSome() {
            r.path = removeDots(r.path)
            return r
        }
        r.user = self.user.clone()
        r.host = self.host.clone()
        r.port = self.port
        if r.path.len() == 0 {
            r.path = self.path.clone()
            if ref.find("?") == none {
                r.rawQuery = self.rawQuery.clone()
            }
            return r
        }
        if !r.path.startsWith("/") {
            // merge: drop the last segment of the base path
            let i = self.path.rfind("/") ?? -1
            var base: String = if i >= 0 { self.path[..i + 1].toString() } else { "/" }
            base.push(r.path)
            r.path = base
        }
        r.path = removeDots(r.path)
        return r
    }
}

// RFC 3986's remove_dot_segments: "/a/b/../c/./d" -> "/a/c/d".
fn removeDots(p: str) -> String {
    var out = Vec[String]{}
    let parts = p.split("/")
    for i, s in parts {
        if s == "." || s == ".." {
            if s == ".." && out.len() > 1 {
                _ = out.pop()
            }
            if i == parts.len() - 1 {
                out.push("")
            }
            continue
        }
        out.push(s.clone())
    }
    var r = out.join("/")
    if p.startsWith("/") && !r.startsWith("/") {
        r.insert(0, "/")
    }
    return r
}

fn unescapeStrict(s: str, what: str) -> String ! Error {
    var out: String = ""
    if !__unescape(s, false, false, &out) {
        return err(Error{msg: "invalid escape in the ${what}"})
    }
    return out
}

fn isSchemeChar(c: byte, first: bool) -> bool {
    let letter = (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
    if first {
        return letter
    }
    return letter || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46
}

// The parts of `s`: an absolute URL (`https://host/path`), or a reference
// relative to one (`/path?q`, `../x`, `#top`).
pub fn parse(s: str) -> Url ! Error {
    var u = Url{}
    var rest = s
    if let i = rest.find("#") {
        u.fragment = try unescapeStrict(rest[i + 1..], "fragment")
        rest = rest[..i]
    }
    if let i = rest.find("?") {
        u.rawQuery = rest[i + 1..].toString()
        rest = rest[..i]
    }
    // a scheme: letters, digits, `+-.`, before the first `:`, and no `/` before it
    if let i = rest.find(":") {
        let b = rest.bytes()
        var ok = i > 0
        for j in 0..i {
            if !isSchemeChar(b[j], j == 0) {
                ok = false
                break
            }
        }
        if ok {
            u.scheme = rest[..i].toLower()
            rest = rest[i + 1..]
        }
    }
    if rest.startsWith("//") {
        rest = rest[2..]
        let end = rest.find("/") ?? rest.len()
        var auth = rest[..end]
        rest = rest[end..]
        if let at = auth.rfind("@") {
            u.user = try unescapeStrict(auth[..at], "user")
            auth = auth[at + 1..]
        }
        var host = auth
        var portText = ""
        if auth.startsWith("[") {
            let close = auth.find("]") ?? return err(Error{msg: "missing `]` after an IPv6 address"})
            host = auth[1..close]
            let after = auth[close + 1..]
            if after.len() > 0 {
                if !after.startsWith(":") {
                    return err(Error{msg: "unexpected text after `]`"})
                }
                portText = after[1..]
            }
        } else if let c = auth.rfind(":") {
            host = auth[..c]
            portText = auth[c + 1..]
        }
        if portText.len() > 0 {
            let p = u16.parse(portText) ?? return err(Error{msg: "invalid port `${portText}`"})
            u.port = int(p)
        }
        u.host = try unescapeStrict(host, "host")
    }
    u.path = try unescapeStrict(rest, "path")
    return u
}

// A query string's parameters, in the order they were added or appeared. A
// name can have several values (`?tag=a&tag=b`).
pub struct Query {
    pairs: Vec[(String, String)] = Vec[(String, String)]{}

    // The first value for `name`.
    pub fn get(self, name: str) -> ?String {
        for p in self.pairs {
            if p.0 == name {
                return p.1.clone()
            }
        }
        return none
    }

    // Every value for `name`, in order.
    pub fn getAll(self, name: str) -> Vec[String] {
        var out = Vec[String]{}
        for p in self.pairs {
            if p.0 == name {
                out.push(p.1.clone())
            }
        }
        return out
    }

    // Whether there is a value for `name`.
    pub fn has(self, name: str) -> bool {
        return self.pairs.any(p => p.0 == name)
    }

    // Adds a value for `name`, after any others.
    pub fn add(inout self, name: str, value: str) {
        self.pairs.push((name.toString(), value.toString()))
    }

    // Makes `value` the only value for `name` (in the place of the first).
    pub fn set(inout self, name: str, value: str) {
        var found = false
        var i = 0
        while i < self.pairs.len() {
            if self.pairs[i].0 == name {
                if found {
                    _ = self.pairs.remove(i)
                    continue
                }
                self.pairs[i].1 = value.toString()
                found = true
            }
            i += 1
        }
        if !found {
            self.add(name, value)
        }
    }

    // Removes every value for `name`.
    pub fn remove(inout self, name: str) {
        self.pairs.retain(p => p.0 != name)
    }

    // The number of (name, value) pairs.
    pub fn len(self) -> int {
        return self.pairs.len()
    }

    // Copies of the (name, value) pairs, in order.
    pub fn entries(self) -> Vec[(String, String)] {
        return self.pairs.clone()
    }

    // The query string: `a=1&b=two+words` (without the `?`).
    pub fn encode(self) -> String {
        var out: String = ""
        for i, p in self.pairs {
            if i > 0 {
                out.push("&")
            }
            out.push(__escape(p.0, 0))
            out.push("=")
            out.push(__escape(p.1, 0))
        }
        return out
    }

    pub fn toString(self) -> String {
        return self.encode()
    }
}

// The parameters of a query string (with or without its `?`). Lenient, as
// browsers are: `+` is a space, and a `%` without two hex digits is kept.
pub fn parseQuery(q: str) -> Query {
    var out = Query{}
    for part in q.trimPrefix("?").split("&") {
        if part.len() == 0 {
            continue
        }
        var name: String = ""
        var value: String = ""
        if let i = part.find("=") {
            _ = __unescape(part[..i], true, true, &name)
            _ = __unescape(part[i + 1..], true, true, &value)
        } else {
            _ = __unescape(part, true, true, &name)
        }
        out.pairs.push((name, value))
    }
    return out
}

// `s` escaped for a query string's name or value: letters, digits and `-._~`
// stay, a space becomes `+`, everything else `%XX`.
pub fn escape(s: str) -> String {
    return __escape(s, 0)
}

// `s` escaped as one segment of a path: like `escape`, but a space is `%20`,
// `/` is escaped, and `:@!$&'()*+,;=` stay.
pub fn pathEscape(s: str) -> String {
    return __escape(s, 1)
}

// The text of a query-string value: `%XX` decoded and `+` a space; none for
// a `%` without two hex digits.
pub fn unescape(s: str) -> ?String {
    var out: String = ""
    if __unescape(s, true, false, &out) {
        return out
    }
    return none
}

// Like `unescape`, for a path: `+` stays a `+`.
pub fn pathUnescape(s: str) -> ?String {
    var out: String = ""
    if __unescape(s, false, false, &out) {
        return out
    }
    return none
}
