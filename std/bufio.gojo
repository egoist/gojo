// Buffered reading and writing on top of io.Reader / io.Writer.
//
//   var input = bufio.reader(os.stdin())
//   loop {
//       let line = try input.readLine() ?? break
//       ...
//   }
//   var out = bufio.writer(os.stdout())
//   try out.writeText("many small writes, one system call\n")
//   try out.flush()
use std/io

fn __indexByte(s: []byte, c: byte) -> int
fn __append(v: inout Vec[byte], s: []byte)
fn __dropFront(v: inout Vec[byte], n: int)

// Reads from `R` in large chunks, and line by line.
pub struct Reader[R: io.Reader] {
    src: R
    buf: Vec[byte] = []
    pos: int = 0
    done: bool = false

    // Gets more input into the buffer; false at the end of the stream.
    fn fill(inout self) -> bool ! io.Error {
        if self.done {
            return false
        }
        if self.pos > 0 {
            // drop what was consumed
            __dropFront(&self.buf, self.pos)
            self.pos = 0
        }
        let n = try self.src.read(&self.buf, 65536)
        if n == 0 {
            self.done = true
        }
        return n > 0
    }

    // The next byte, or none at the end.
    pub fn readByte(inout self) -> ?byte ! io.Error {
        if self.pos >= self.buf.len() {
            if !try self.fill() {
                return none
            }
        }
        let b = self.buf[self.pos]
        self.pos += 1
        return some(b)
    }

    // Everything up to and including `delim` (or to the end), or none when
    // nothing is left.
    pub fn readUntil(inout self, delim: byte) -> ?Vec[byte] ! io.Error {
        let end = try self.scan(delim)
        if end == self.pos {
            return none
        }
        var out = Vec[byte]{}
        __append(&out, self.buf[self.pos..end])
        self.pos = end
        return some(out)
    }

    // The next line without its "\n" (or "\r\n"), or none at the end.
    pub fn readLine(inout self) -> ?String ! io.Error {
        let end = try self.scan(10)
        if end == self.pos {
            return none
        }
        var stop = end
        if self.buf[stop - 1] == 10 {
            stop -= 1
            if stop > self.pos && self.buf[stop - 1] == 13 {
                stop -= 1
            }
        }
        let line = String(self.buf[self.pos..stop])
        self.pos = end
        return some(line)
    }

    // Buffers input until it holds `delim` (or the stream ends), and returns
    // the index just past it (or the end of the buffer). Reading resumes where
    // the last search stopped, so a long line is scanned once. On an error the
    // buffered bytes are dropped, as if they had been read.
    fn scan(inout self, delim: byte) -> int ! io.Error {
        errdefer {
            self.pos = self.buf.len()
        }
        var from = self.pos
        loop {
            let i = __indexByte(self.buf[from..], delim)
            if i >= 0 {
                return from + i + 1
            }
            let seen = self.buf.len() - self.pos
            if !try self.fill() {
                return self.buf.len()
            }
            from = self.pos + seen
        }
    }

    // As an io.Reader: what is buffered first.
    pub fn read(inout self, buf: inout Vec[byte], max: int) -> int ! io.Error {
        if self.pos >= self.buf.len() {
            if !try self.fill() {
                return 0
            }
        }
        var n = self.buf.len() - self.pos
        if n > max {
            n = max
        }
        if n <= 0 {
            return 0
        }
        __append(&buf, self.buf[self.pos..self.pos + n])
        self.pos += n
        return n
    }

    // Everything that is left.
    pub fn readAll(inout self) -> Vec[byte] ! io.Error {
        var out = Vec[byte]{}
        loop {
            let n = try self.read(&out, 65536)
            if n == 0 {
                return out
            }
        }
    }
}

// A buffered reader on `src` (which it owns).
pub fn reader[R: io.Reader](src: sink R) -> Reader[R] {
    return Reader[R]{src: src}
}

// Collects small writes and passes them to `W` in large ones (64 KB). What is
// still buffered is written when the writer is dropped, but call `flush` to
// see errors.
pub struct Writer[W: io.Writer] {
    dst: W
    buf: Vec[byte] = []
    size: int = 65536

    // Buffers `data` (large writes go straight through).
    pub fn write(inout self, data: []byte) ! io.Error {
        if self.buf.len() + data.len() > self.size {
            try self.flush()
        }
        if data.len() >= self.size {
            return self.dst.write(data)
        }
        __append(&self.buf, data)
    }

    // Buffers the bytes of `s`.
    pub fn writeText(inout self, s: str) ! io.Error {
        return self.write(s.bytes())
    }

    // Writes out everything buffered.
    pub fn flush(inout self) ! io.Error {
        if self.buf.len() > 0 {
            let pending = take(&self.buf)
            try self.dst.write(pending)
        }
    }

    // Flushes; an error here is lost, so call `flush` when it matters.
    fn drop(inout self) {
        _ = self.flush()
    }
}

// A buffered writer on `dst` (which it owns).
pub fn writer[W: io.Writer](dst: sink W) -> Writer[W] {
    return Writer[W]{dst: dst}
}
