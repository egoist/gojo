struct Bag {
    items: Vec[int]

    fn each(self, body: fn(int) -> Flow) {
        for x in self.items {
            if body(x) == .Break {
                return
            }
        }
    }

    fn add(inout self, x: int) {
        self.items.push(x)
    }
}

struct Plain { x: int }

fn take(s: sink String) {}

fn main() {
    var b = Bag{items: [1]}
    for x in b {
        b.add(x)
    }
    // a lazy chain borrows its source for the whole loop
    var v = [1, 2]
    for x in v.iter().map(x => x + 1) {
        v.push(x)
    }
    var m = ["a": 1]
    for _key, _n in m.iter().filter((_key, n) => n > 0) {
        _ = m.insert("b", 2)
    }
}
// error: cannot modify `b` while iterating over it
// error: cannot modify `v` while it is borrowed
// error: cannot modify `m` while it is borrowed
