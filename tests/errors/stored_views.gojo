// Views live only in variables; nothing may store one.
interface Len {
    fn len(self) -> int
}

fn arrays() {
    var a: [1]str
    // error: `a` has type `[1]str`, which would store a borrowed view
    let s = "abc".toString()
    a[0] = s.asStr()
}

fn boxes() {
    let s = "abc".toString()
    let b = Box(s.asStr())
    // error: `b` has type `Box[str]`, which would store a borrowed view
    let r = Rc(s.asStr())
    // error: `r` has type `Rc[str]`, which would store a borrowed view
    println(b, r)
}

fn maps() {
    var m = Map[int, str]{}
    // error: `m` has type `Map[int, str]`, which would store a borrowed view
    println(m.len())
}

fn locks() {
    var n = 0
    var keep = Vec[MutexRef[int]]{}
    // error: `keep` has type `Vec[MutexRef[int]]`, which would store a borrowed view
    keep.push(Mutex(&n))
}

fn interfaces() {
    var xs = Vec[Len]{}
    let s = "abc".toString()
    xs.push(s.asStr())
    // error: the borrowed view `str` cannot be boxed into an interface value
}

fn result_view() -> str ! String {
    let s = "abc".toString()
    return s.asStr()
    // error: returns a view of `s`, which is dropped when the function returns
}

fn main() {
    arrays()
    boxes()
    maps()
    locks()
    interfaces()
    _ = result_view()
}
