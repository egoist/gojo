struct Stack[T] { items: Vec[T] }
fn wrap[T](x: T) -> Vec[T] {
    var v = Vec[T]{}
    v.push(x)
    return v
}
fn main() {
    let s = "abc".toString()
    let v = [s.asStr()]
    let st = Stack[str]{items: Vec[str]{}}
    let w = wrap(s.asStr())
    _ = v
    _ = st
    _ = w
    // error: `Stack` cannot be instantiated with a borrowed view type
}
