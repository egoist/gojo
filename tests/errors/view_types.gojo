// Only a `view` type may hold views (or a field declared `of` another);
// and like `str`, a view type lives only in variables.
view struct Token {
    text: str
    n: int
}

struct Holder {
    t: Token
    // error: field `t` has borrowed view type `Token`; fields must own their data
}

view struct Dropped {
    // error: `Dropped` is a view type: it can't have a `drop` method
    s: str

    fn drop(inout self) {}
}

view struct WithScope {
    s: Scope
    // error: `WithScope` can't hold `Scope`
}

enum Plain {
    Word(str)
    // error: payload `_0` has borrowed view type `str`; fields must own their data
}

fn main() {}
