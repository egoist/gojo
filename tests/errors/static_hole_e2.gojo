linear struct Tx {
    id: int

    fn commit(sink self) {
        println("commit", self.id)
    }
}

linear struct Pair {
    t: Tx
    n: int
}

fn mk[T: any](fail: bool) -> T ! String {
    static if T is Tx {
        return Tx{id: 1}
    } else static if T is int {
        if fail {
            return err("fail")
        }
        return 5
    } else static if T: struct {
        return static T{f => try mk(fail)}
    } else {
        return err("no")
    }
}

fn main() {
    let p = mk[Pair](true) catch e {
        println(e)
        return
    }
    p.t.commit()
}
// error: a field's `try` here may leave after earlier fields of the linear `T` were built, and they would be dropped
