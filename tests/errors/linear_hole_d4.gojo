linear struct Tx {
    id: int
    name: String

    fn commit(sink self) {
        println("commit", self.id)
    }

    fn rollback(sink self) {
        println("rollback", self.id)
    }
}

fn begin(id: int) -> Tx {
    return Tx{id: id, name: "tx" + "{id}"}
}
fn each(xs: []int, f: fn(int)) {
    for x in xs {
        f(x)
    }
}
fn main() {
    var o: ?Tx = none
    each([1], x => {
        o = some(begin(x))
    })
    println(o.isSome())
}
// error: `o` is not consumed: the linear `?Tx` would be dropped where its block ends
// error: assigning here drops the linear `?Tx` that was there
