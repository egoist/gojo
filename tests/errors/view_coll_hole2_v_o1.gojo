fn mk(s: str) -> ?Vec[str] { return [s] }
fn mkr(s: str) -> Vec[str] ! String { return [s] }
fn main() {
    var d: Vec[str] = []
    var s = "hello".toString()
    if let x = mk(s.asStr()) { d.extend(x) }
    s.push("defghijklmnopqrstuvwxyz0123456789")
    println(d)
}
// error: `s` does not live long enough: `d` would still view it after it is dropped
