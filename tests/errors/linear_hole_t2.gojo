linear struct Tx {
    id: int
    name: String

    fn commit(sink self) {
        println("commit", self.id)
    }

    fn rollback(sink self) {
        println("rollback", self.id)
    }
}

fn begin(id: int) -> Tx {
    return Tx{id: id, name: "tx" + "{id}"}
}
fn new() -> Vec[Tx] {
    return [begin(1), begin(2)]
}
fn main() {
    new()
    var w = new()
    w = new()
    println(w.len())
}
// error: this linear `Vec[Tx]` is thrown away
// error: `w` is not consumed: the linear `Vec[Tx]` would be dropped where its block ends
