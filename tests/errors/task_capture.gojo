// What a task borrows must live until its scope ends: data declared outside
// the scope or directly in its body. Values declared in blocks inside the
// body are moved (or copied) into the task.
fn work(items []String) {
    scope {
        // fine: `r` points into `items`, which outlives the scope
        for s in items {
            let r = s
            go () => { println(r) }
        }
        if items.len() > 0 {
            let inner = ["b".toString()]
            let first = inner[0]
            go () => { println(first) }
            // error: a task borrows `first`, which does not live until the scope ends
        }
    }
}

fn main() {
    scope {
        for i in 0..2 {
            var mine = i
            go () => { mine += 1 }
            // error: a task cannot modify `mine`: it gets its own copy
        }
    }
    work(["a"])
}
