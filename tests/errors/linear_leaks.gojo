linear struct Tx {
    id: int

    fn commit(sink self) {
        println("commit", self.id)
    }

    fn rollback(sink self) {
        println("rollback", self.id)
    }
}

fn begin(id: int) -> Tx {
    return Tx{id}
}

fn leak1() {
    let _tx = begin(1)
}
fn leak2(c: bool) {
    let tx = begin(1)
    if c {
        tx.commit()
    }
}
fn leak3() {
    begin(1)
    _ = begin(2)
    println(begin(3).id)
}
fn leak4(c: bool) -> int {
    let tx = begin(1)
    if c {
        return 1
    }
    tx.commit()
    return 0
}
fn leak5() {
    var tx = begin(1)
    tx = begin(2)
    tx.commit()
}
fn leak6() {
    let tx = begin(1)
    let f = () => println(tx.id)
    f()
    tx.commit()
}
fn leak7() {
    let r: Rc[Tx] = Rc(begin(1))
    println(r.id)
    drop(begin(2))
    var v: Vec[Tx] = []
    v.push(begin(3))
    v.clear()
}
fn leak8(t: sink Tx) {
    println(t.id)
}
fn leak9() {
    for i in 0..3 {
        let tx = begin(i)
        if i == 1 {
            continue
        }
        tx.commit()
    }
}
fn leak10() -> int ! String {
    let tx = begin(1)
    let n = try parse()
    tx.commit()
    return n
}
fn parse() -> int ! String {
    return 1
}
