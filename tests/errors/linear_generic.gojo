linear struct Tx {
    id: int

    fn commit(sink self) {
        println("commit", self.id)
    }

    fn rollback(sink self) {
        println("rollback", self.id)
    }
}

fn begin(id: int) -> Tx {
    return Tx{id}
}

interface Named {
    fn name(self) -> String
}

linear struct Tn {
    fn name(self) -> String {
        return "tn"
    }

    fn end(sink self) {}
}

struct Plain[T] {
    v: T
}

fn keep[T: any](x: sink T) {
    println("kept")
}

fn wrap[T](x: sink T) -> ?T {
    return some(x)
}

fn outer[U: any](u: sink U) -> ?U {
    return wrap(u)
}

fn show(n: Named) {
    println(n.name())
}

fn main() {
    let _p = Plain[Tx]{v: begin(1)}
    let _n: Named = Tn{}
    show(Tn{})
    let _m: Map[String, Tx] = [:]
    let _arr: [2]Tx = [begin(1), begin(2)]
    let _b = Box(begin(3))
    let t = begin(5)
    match begin(6) {
        x => println(x.id)
    }
    t.commit()
}
// error: `x` is not consumed: the linear `T` would be dropped where the function ends
// error: `wrap` may drop its `T` values, and `U` is linear
// error: `Plain[Tx]` may drop its `T` values, and `Tx` is linear
