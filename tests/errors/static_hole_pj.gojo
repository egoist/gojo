struct P { a: String, b: String }

fn conv[F](x: sink String) -> F {
    static if F is String {
        return x
    }
    panic("no")
}

fn main() {
    let opt: ?String = some("a long heap string xxxxxxxxxxxxxxxxxxxxxxxxxxx ${1}")
    let p = static P{f => conv(if let v = opt { v } else { "x" })}
    println(p.a, p.b)
}
// error: a `static T { }` value runs once for each field, so it can't move a value declared outside it
