// A type with no YAML form is an error at the encode or decode that needs it.
use std/yaml

struct Job {
    name: String
    run: fn(int) -> int
}

fn main() {
    println(yaml.decode[Job]("name: x"))
    // error: `yaml.decode` can't handle `fn(int) -> int` (in field `run` of `Job`): a function has no YAML form
}
