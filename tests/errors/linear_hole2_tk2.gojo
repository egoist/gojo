fn main() {
    var p: (Vec[Tx], Tx) = ([begin(1)], begin(2))
    var w = replace(&p.0, [])
    loop { let t = w.pop() else { break }
        t.commit() }
    w.finish()
    println("end")
}

linear struct Tx {
    id: int
    name: String

    fn commit(sink self) {
        println("commit", self.id)
    }

    fn rollback(sink self) {
        println("rollback", self.id)
    }
}

fn begin(id: int) -> Tx {
    return Tx{id: id, name: "tx" + "{id}"}
}
// error: `p.1` is not consumed: the linear `Tx` would be dropped where its block ends
