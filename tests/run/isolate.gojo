// `isolate`: a tree of `rc` nodes, built from values that can cross tasks, is
// sent to another task as a whole.
struct Node {
    value: int
    children: Vec[Rc[Node]]
    parent: ?Weak[Node]
}

fn build(depth: int, v: int) -> Rc[Node] {
    var kids = Vec[Rc[Node]]{}
    if depth > 0 {
        kids.push(build(depth - 1, v * 2))
        kids.push(build(depth - 1, v * 2 + 1))
    }
    return Rc(Node{value: v, children: kids, parent: none})
}

fn sum(n: Rc[Node]) -> int {
    var t = n.value
    for c in n.children {
        t += sum(c.clone())
    }
    return t
}

fn total(t: sink Iso[Rc[Node]]) -> int {
    return sum(t.take())
}

fn main() {
    let depth = 4
    let tree = isolate {
        build(depth, 1)
    }
    let r = scope {
        let t = go total(tree)
        t.join()
    }
    println("sum", r)
}
