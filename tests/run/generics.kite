use std/fmt

struct Stack[T any] {
    items Vec[T]

    // no `self`: an associated function, called as `Stack[T].new()`
    fn new() Stack[T] {
        return Stack[T]{items: Vec[T]{}}
    }

    fn push(self inout, x sink T) {
        self.items.push(x)
    }

    fn pop(self inout) ?T {
        return self.items.pop()
    }

    fn peek(self) yield ?&T {
        if self.items.len == 0 {
            yield none
        }
        yield self.items[self.items.len - 1]
    }

    fn size(self) int {
        return self.items.len
    }
}

struct Pair[A any, B any] {
    first A
    second B
}

fn swapPair[A any, B any](p sink Pair[A, B]) Pair[B, A] {
    return Pair[B, A]{first: p.second, second: p.first}
}

fn largest[T copy + ordered](xs []T) ?T {
    if xs.len == 0 {
        return none
    }
    var best = xs[0]
    for x in xs {
        if x > best {
            best = x
        }
    }
    return best
}

interface Shape {
    fn area(self) f64
    fn name(self) String
}

struct Square {
    side f64

    fn area(self) f64 { return self.side * self.side }

    fn name(self) String { return "square".toString() }
}
struct Circle {
    r f64

    fn area(self) f64 { return 3.0 * self.r * self.r }

    fn name(self) String { return "circle".toString() }
}

fn totalArea[S Shape](shapes []S) f64 {
    var t = 0.0
    for s in shapes {
        t += s.area()
    }
    return t
}

fn describe[T Shape](s T) String {
    return fmt.sprint(s.name(), s.area())
}

enum Tree[T any] {
    Leaf
    Node(left Box[Tree[T]], value T, right Box[Tree[T]])
}

fn insert(t sink Tree[int], v int) Tree[int] {
    return match t {
        Leaf => Tree.Node(Box(Tree[int].Leaf), v, Box(Tree[int].Leaf))
        Node(l, x, r) => if v < x {
            Tree.Node(Box(insert(*l, v)), x, r)
        } else {
            Tree.Node(l, x, Box(insert(*r, v)))
        }
    }
}

fn walk(t Tree[int], out inout Vec[int]) {
    match t {
        Leaf => {}
        Node(l, x, r) => {
            walk(l, &out)
            out.push(x)
            walk(r, &out)
        }
    }
}

fn apply[T any, U any](x T, f fn(T) U) U {
    return f(x)
}

fn compose(f fn(int) int, g fn(int) int) fn(int) int {
    return (x int) => x + 1
}

fn main() {
    var s = Stack[String].new()
    let ints Stack[int] = Stack.new()
    println(ints.size())
    s.push("a".toString())
    s.push("b".toString())
    if let top = s.peek() {
        println("top", top)
    }
    println(s.pop(), s.size())

    let p = Pair{first: 1, second: "one"}
    let q = swapPair(p)
    println(q.first, q.second)

    println(largest([3, 9, 2]), largest([1.5, 0.5]), largest(Vec[int]{}))
    println(min(3, 4), max("a", "b"))

    let squares = [Square{side: 1.0}, Square{side: 2.0}]
    println(totalArea(squares), describe(Circle{r: 1.0}))

    var t = Tree[int].Leaf
    for v in [5, 3, 8, 1, 4] {
        t = insert(t, v)
    }
    var out = Vec[int]{}
    walk(t, &out)
    println(out)

    println(apply(21, (x) => x * 2), apply("hi", (w) => w.len))
    let words = ["apple", "kiwi", "banana"]
    let lens = words.map((word) => word.len)
    let total = lens.fold(0, (acc, n) => acc + n)
    println(lens, total)
    let inc = compose((x) => x, (x) => x)
    println(inc(41))
}
