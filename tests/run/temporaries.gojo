// Temporaries live until their statement is done with them.
fn bytes() -> Vec[byte] {
    var v = Vec[byte]{}
    for _ in 0..100000 { v.push(120) }
    return v
}

fn tryBytes() -> Vec[byte] ! String {
    return bytes()
}

fn text() -> String ! String {
    // the Vec is a temporary; the String must be built before it is freed
    let s = String(try tryBytes())
    return s
}

fn main() {
    let a = String(bytes())
    let b = text().unwrap()
    let c = String(bytes()).len() + String(try_or_empty()).len()
    println(a.len(), b.len(), c)
}

fn try_or_empty() -> Vec[byte] {
    return tryBytes() catch _e { Vec[byte]{} }
}
