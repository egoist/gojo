// TCP and UDP: echo servers and their clients, all goroutines in one process;
// name lookups.
use std/{fmt, net, task, time}

fn serve(c: net.Conn) {
    var buf = Vec[byte]{}
    loop {
        buf.clear()
        let n = c.read(&buf, 4096) catch _e {
            return
        }
        if n == 0 { return }
        c.write(buf) catch _e {
            return
        }
    }
}

fn client(port: int, id: int) -> String ! net.Error {
    let c = try net.dial(fmt.sprint("127.0.0.1:", port))
    let msg = fmt.sprint("client", id)
    try c.writeText(msg)
    c.closeWrite()
    let reply = try c.readAll()
    return String(reply)
}

fn main() {
    let ln = net.listen("127.0.0.1:0").unwrap()
    let port = ln.port()
    println("listening", port > 0)

    // the server accepts in a scope of its own; cancelling the scope stops it
    let replies = Mutex(Vec[String]{})
    scope g {
        go () => {
            scope {
                loop {
                    let c = ln.accept() catch e {
                        println("accept stopped, cancelled:", e.isCancelled())
                        break
                    }
                    go serve(c)
                }
            }
        }
        let clients = scope {
            for id in 0..50 {
                go () => {
                    let reply = try client(port, id)
                    with l = replies.lock() { l.push(reply) }
                }
            }
        }
        println("clients ok", clients.isOk())
        g.cancel()
    }
    println("scope done")
    with l = replies.lock() {
        l.sort()
        println(l.len, l[0], l[49])
    }

    // a read with a deadline: the peer never answers
    let quiet = net.listen("127.0.0.1:0").unwrap()
    let c = net.dial(fmt.sprint("127.0.0.1:", quiet.port())).unwrap()
    let start = time.now()
    let got = task.timeout(10 * time.millisecond, () => {
        var buf = Vec[byte]{}
        return c.read(&buf, 10)
    })
    // the deadline cancels the read; timeout reports none
    println("read timed out", got.isNone(), "fast", time.since(start) < time.second)

    // errors are values
    match net.dial("127.0.0.1:1") {
        err(e) => println("dial failed:", e.message().contains("refused"))
        ok(_) => println("connected?")
    }

    // UDP: one datagram per call, the sender's address comes with it
    let udp = net.listenUdp(":0").unwrap()
    let up = udp.port()
    scope {
        go () => {
            var buf = Vec[byte]{}
            for _ in 0..2 {
                buf.clear()
                let (n, from) = udp.recvFrom(&buf, 1500) catch _e {
                    return
                }
                udp.sendTo(buf[..n], from) catch _e {
                    return
                }
            }
        }
        let peer = net.dialUdp("127.0.0.1:${up}").unwrap()
        var buf = Vec[byte]{}
        peer.send("hello".bytes()).unwrap()
        println("udp echo", peer.recv(&buf, 1500).unwrap(), String(buf))
        let other = net.listenUdp("127.0.0.1:0").unwrap()
        other.sendTo("ping".bytes(), "localhost:${up}").unwrap()
        buf.clear()
        let (n, from) = other.recvFrom(&buf, 2).unwrap()
        // a longer datagram is cut to `max`; the reply comes from the server's port
        println("udp from", n, String(buf), from == "127.0.0.1:${up}")
    }
    let silent = net.listenUdp("127.0.0.1:0").unwrap()
    let waited = task.timeout(10 * time.millisecond, () => {
        var buf = Vec[byte]{}
        return silent.recv(&buf, 10)
    })
    println("udp recv timed out", waited.isNone())
    match udp.sendTo("x".bytes(), "no port") {
        err(e) => println(e)
        ok(_) => println("sent?")
    }

    // lookups go through /etc/hosts and DNS; literals come back as they are
    println(net.lookup("localhost").unwrap().contains("127.0.0.1"), net.lookup("::1").unwrap())
    match net.lookup("no-such-host.invalid") {
        err(e) => println(e, e.isNotFound())
        ok(v) => println("found?", v)
    }
}
