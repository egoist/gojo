// Moves in `defer` and `errdefer`, on every way out of a block.
fn take(s: sink String) {}
fn f(fail: bool) -> String ! String {
    let s: String = "abcdefghijklmnopqrstuvwxyz0123456789"
    errdefer take(s)
    if fail {
        return err("e")
    }
    return s
}
fn g() {
    let s: String = "abcdefghijklmnopqrstuvwxyz0123456789"
    defer take(s)
    println("g")
}
fn main() {
    println(f(false) catch e { e })
    println(f(true) catch e { e })
    g()
    for i in 0..3 {
        let t: String = "abcdefghijklmnopqrstuvwxyz0123456789"
        defer take(t)
        if i == 1 {
            continue
        }
        if i == 2 {
            break
        }
    }
}
