}

// l/l1
fn main_l_l1() {
    let s = "hello world".toString()
    var m: Map[String, Vec[str]] = [:]
    with e = m.entry("k".toString()) { e.push(s.asStr()) }
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(m, junk)
}

