// View collections: programs a second review found mishandled (memory
// freed early, or wrongly rejected).

// l/l15
fn main_l_l15() {
    let s = "hello world".toString()
    var ws: Vec[str] = ["a"]
    ws[0] = s.asStr()
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(ws, junk)
}

// l/l6
fn main_l_l6() {
    let s = "hello world".toString()
    var vv: Vec[Vec[str]] = [[]]
    vv[0].push(s.asStr())
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(vv, junk)
}

// l/l14
fn main_l_l14() {
    let s = "hello world".toString()
    var m: Map[int, Vec[str]] = [:]
    m[1] = []
    m[1].push(s.asStr())
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(m, junk)
}

// l/l7
view struct Tok_l_l7 { text: str }
fn main_l_l7() {
    let s = "hello world".toString()
    var ts: Vec[Tok_l_l7] = [Tok_l_l7{text: "a"}]
    ts[0].text = s.asStr()
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(ts[0].text, junk)
}

// l/l2
fn main_l_l2() {
    let s = "hello world".toString()
    var ws: Vec[str] = ["a"]
    for x in &ws { x = s.asStr() }
    let junk = "XXXXXXXXXXXXXXXXXXXXXXX".toString()
    println(ws, junk)
}

