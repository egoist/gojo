// bufio: lines, delimiters and buffered writes, over files and memory.
use std/{bufio, fmt, io, os}

fn lines(text: str) ! io.Error {
    var r = bufio.reader(io.textReader(text))
    var n = 0
    loop {
        let line = try r.readLine() ?? break
        n += 1
        println(n, "[" + line + "]")
    }
}

// A reader that gives at most `step` bytes a call, and fails the first call
// at or past byte `failAt` (once).
struct Trickle {
    data: Vec[byte]
    step: int
    failAt: int = -1
    pos: int = 0

    fn read(inout self, buf: inout Vec[byte], max: int) -> int ! io.Error {
        if self.failAt >= 0 && self.pos >= self.failAt {
            self.failAt = -1
            return err(io.Error{kind: .Other, msg: "trickle failed"})
        }
        var n = 0
        while n < self.step && n < max && self.pos < self.data.len() {
            buf.push(self.data[self.pos])
            self.pos += 1
            n += 1
        }
        return n
    }
}

fn trickle(text: str, step: int, failAt: int) -> bufio.Reader[Trickle] {
    return bufio.reader(Trickle{data: text.bytes().toVec(), step: step, failAt: failAt})
}

// readLine until the end, showing errors and going on after them.
fn trickleLines(text: str, step: int, failAt: int) {
    var r = trickle(text, step, failAt)
    loop {
        let line = r.readLine() catch e {
            println("error:", e.message())
            continue
        }
        print("[" + (line ?? break) + "]")
    }
    println()
}

fn main() {
    // lines and "\r\n" split across reads; at the end, a "\r" with no "\n"
    // after it stays
    trickleLines("ab\r\ncd\n\r\nlast\r", 3, -1)
    trickleLines("ab\r\ncd\n\r\nlast\r", 1, -1)
    // a failed read drops the part of the line read so far; reading goes on
    trickleLines("one\ntwo\nthree\n", 5, 6)

    // a line longer than the buffer's 64 KB reads, needing several fills
    var long = bufio.reader(io.textReader("x".repeat(200000) + "\ny"))
    println(long.readLine().unwrap().unwrap().len(), long.readLine().unwrap().unwrap())

    // readUntil keeps the delimiter, across reads too
    var until = trickle("k=v;key=value;tail", 4, -1)
    loop {
        let field = until.readUntil(59).unwrap() ?? break
        print("[" + String(field) + "]")
    }
    println()

    // read hands over what is buffered, at most `max` at a time
    var mixed = trickle("hello\nworld", 64, -1)
    var got = Vec[byte]{}
    println(mixed.readLine().unwrap().unwrap(), mixed.read(&got, 3).unwrap(), mixed.read(&got, 10).unwrap(), mixed.read(&got, 10).unwrap(), String(got))

    lines("one\ntwo\r\nthree") catch e { println(e.message()) }
    lines("") catch e { println(e.message()) }
    lines("\n\n") catch e { println(e.message()) }

    let path = os.joinPath(os.tempDir(), "gojo-buffered-test.txt")
    {
        var f = bufio.writer(os.create(path).unwrap())
        for i in 0..3000 {
            f.writeText("line " + fmt.sprint(i) + "\n") catch e { println(e.message()) }
        }
        // flushed when it goes out of scope
    }
    var r = bufio.reader(os.open(path).unwrap())
    var count = 0
    var last: String = ""
    loop {
        let line = r.readLine().unwrap() ?? break
        count += 1
        last = line
    }
    println(count, last)
    _ = os.remove(path)

    var w = bufio.writer(io.Buffer{})
    w.writeText("a,b,c") catch e { println(e.message()) }
    w.flush() catch e { println(e.message()) }

    var csv = bufio.reader(io.textReader("a,bb,,ccc"))
    loop {
        let field = csv.readUntil(44).unwrap() ?? break
        print(field.len(), " ")
    }
    println()
}
