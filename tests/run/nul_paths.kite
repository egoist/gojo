// A NUL byte can't be part of a path, name or argument: the call fails
// instead of using only what comes before it.
use std/{io, net, os}

fn invalid(e io.Error) bool {
    return e.kind == .InvalidInput
}

fn main() {
    let dir = os.joinPath(os.tempDir(), "kite-nul-test")
    _ = os.removeAll(dir)
    os.mkdir(dir).unwrap()
    let file = os.joinPath(dir, "a.txt")
    let bad = file + "\x00/elsewhere"

    os.writeText(bad, "x") catch e { println("writeText:", invalid(e)) }
    _ = os.create(bad) catch e {
        println("create:", invalid(e))
        os.stdout()
    }
    println("created:", os.exists(file))
    os.writeText(file, "x").unwrap()
    _ = os.readText(bad) catch e {
        println("readText:", invalid(e))
        "".toString()
    }
    _ = os.stat(bad) catch e {
        println("stat:", invalid(e))
        os.stat(file).unwrap()
    }
    os.rename(file, bad) catch e { println("rename:", invalid(e)) }
    os.remove(bad) catch e { println("remove:", invalid(e)) }
    os.mkdir(dir + "\x00x") catch e { println("mkdir:", invalid(e)) }
    os.setenv("KITE_NUL", "a\x00b") catch e { println("setenv:", invalid(e)) }
    println("getenv:", os.getenv("HOME\x00").isNone())
    _ = os.run("echo", ["a\x00b".toString()]) catch e {
        println("run:", invalid(e))
        os.Output{status: 0, stdout: "", stderr: ""}
    }
    println("still there:", os.exists(file))
    os.removeAll(dir).unwrap()
    _ = net.dial("127.0.0.1\x00:80") catch e {
        println("dial:", invalid(e))
        return
    }
}
