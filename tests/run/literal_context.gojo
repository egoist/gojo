// A literal takes its type from the other operand, also when it sits in an
// `if`, a `match`, a block or a literal expression on the left.
fn main() {
    let v u8 = 10
    let c = v > 3
    let a = (if c { 5 } else { 7 }) +% v
    let b = v +% (if c { 5 } else { 7 })
    let m = (match v { 0 => 1, _ => 2 }) * v
    let blk = { 3 } + v
    let sum = (1 + 2) * v
    let neg = -(if c { 1.5 } else { 2.5 }) * f32(2)
    println(a, b, m, blk, sum, neg)
    // comparisons too
    println((if c { 9 } else { 99 }) < v, 'a' == 'a')
    // both sides literal: the expected type, else `int`
    let w u16 = (if c { 600 } else { 700 }) + 1
    let i = (if c { 2 } else { 3 }) * 1000000000000
    println(w, i)
}
