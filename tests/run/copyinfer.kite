// Package-private types whose fields are all copy are copy themselves.
struct Point { x, y int }
enum Dir { North, South }
struct Seg { a Point, b Point, d Dir }

fn len2(s sink Seg) int {
    let dx = s.b.x - s.a.x
    let dy = s.b.y - s.a.y
    return dx * dx + dy * dy
}

fn main() {
    let p = Point{x: 1, y: 2}
    let q = p
    let s = Seg{a: p, b: Point{x: 4, y: 6}, d: .North}
    println(len2(s), len2(s), p, q, s.d)
}
