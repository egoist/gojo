// Tasks are scheduled onto a few threads; blocking parks only the task.
use std/{fmt, time, task}

fn pingPong(n int) int {
    let ping = chan[int]()
    let pong = chan[int]()
    let pings = ping.rx
    let pongs = pong.tx
    return scope {
        // the task borrows one end of each channel
        go () => {
            for v in pings {
                pongs <- v + 1
            }
        }
        var last = 0
        for i in 0..n {
            ping.tx <- i
            last = (<-pong.rx).unwrap()
        }
        // the last sender gone: the task's loop ends
        drop(ping.tx)
        last
    }
}

fn main() {
    // many goroutines at once, each parked on a channel
    let n = 10000
    let start = chan[bool]()
    let done = chan[int](n)
    for i in 0..n {
        let s = start.rx.clone()
        let d = done.tx.clone()
        go () => {
            _ = <-s
            d <- i
        }
    }
    drop(start.tx)
    var sum = 0
    for _ in 0..n {
        sum += (<-done.rx).unwrap()
    }
    println("goroutines", n, "sum", sum)

    // unbuffered hand-offs
    println("ping-pong", pingPong(10000))

    // a lock that parks goroutines instead of threads
    let counter = arc(Mutex(0))
    let fin = chan[bool](8)
    for _ in 0..8 {
        let c = counter.clone()
        let f = fin.tx.clone()
        go () => {
            for _ in 0..10000 {
                with v = c.lock() {
                    v += 1
                }
            }
            f <- true
        }
    }
    for _ in 0..8 {
        _ = <-fin.rx
    }
    with v = counter.lock() {
        println("counter", v)
    }

    // timers: sleepers wake in order of their deadlines, not of when they started
    // (10 ms apart: some virtual machines only have 3 ms timer precision)
    let order = chan[int](20)
    let base = time.now() + 20 * time.millisecond
    for i in 0..20 {
        let o = order.tx.clone()
        let at = base + (19 - i) * 10 * time.millisecond
        go () => {
            time.sleep(at - time.now())
            o <- at
        }
    }
    // Started in reverse order, so waking in start order would invert all 190
    // pairs. Neighbors may swap when an overloaded machine runs the scheduler
    // late and both have expired by then.
    var got = Vec[int]{}
    for _ in 0..20 {
        got.push((<-order.rx).unwrap())
    }
    var inversions = 0
    for i in 0..20 {
        for j in i + 1..20 {
            if got[j] < got[i] {
                inversions += 1
            }
        }
    }
    println("timers in order", inversions <= 5)

    // select waits on several channels without spinning
    let a = chan[int]()
    let b = chan[String]()
    let ac = a.tx.clone()
    let bc = b.tx.clone()
    go () => {
        time.sleep(time.millisecond)
        bc <- "late"
        time.sleep(time.millisecond)
        ac <- 7
    }
    for _ in 0..2 {
        select {
            let x = <-a.rx => println("a", x)
            let s = <-b.rx => println("b", s)
        }
    }

    // a goroutine stuck in a long computation doesn't hold up the others
    let spin = chan[int](1)
    let sc = spin.tx.clone()
    go () => {
        var x = 0
        for i in 0..200000000 { x = x +% i }
        sc <- x
    }
    let quick = chan[bool](1)
    let qc = quick.tx.clone()
    go () => { qc <- true }
    println("quick", (<-quick.rx).unwrap())
    _ = <-spin.rx

    // yieldNow lets others run
    task.yieldNow()
    println(fmt.sprint("done"))
}
