// A task borrows what lives until its scope ends (declared outside it, or
// directly in its body), and takes what was declared in blocks inside it.
use std/fmt

struct Res {
    name: String
    dropped: Arc[Mutex[int]]

    fn drop(inout self) {
        with n = self.dropped.lock() { n += 1 }
    }
}

fn main() {
    let dropped = Arc(Mutex(0))
    let shared = "outside"
    let out = Mutex(Vec[String]{})
    scope g {
        for i in 0..5 {
            let res = Res{name: fmt.sprint("res", i), dropped: dropped.clone()}
            go () => {
                with o = out.lock() { o.push(res.name.clone() + " " + shared) }
            }
        }
        // declared in the body itself: borrowed
        let n = 7
        let label = String("body")
        go () => {
            with o = out.lock() { o.push(fmt.sprint(label, n)) }
            g.cancel()
        }
    }
    with o = out.lock() {
        o.sort()
        println(o)
    }
    with n = dropped.lock() {
        println("dropped", n)
    }
}
