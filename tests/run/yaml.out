web nginx:1.27 [80, 443] {"LOG": "info", "TZ": "UTC"} OnFailure Http("/health", 8080) none (0.5, "512Mi")
worker app:latest [] {"LOG": "debug"} Never Exec(["run", "--once"]) some(3) (1, "256Mi")
version: "3.10"
services:
  web:
    image: nginx:1.27
    ports:
      - 80
      - 443
    env:
      LOG: info
      TZ: UTC
    restart: OnFailure
    check:
      Http:
        path: /health
        port: 8080
    replicas: null
    limits:
      - 0.5
      - 512Mi
  worker:
    image: app:latest
    ports: []
    env:
      LOG: debug
    restart: Never
    check:
      Exec:
        cmd:
          - run
          - --once
    replicas: 3
    limits:
      - 1.0
      - 256Mi
volumes:
  - data
  - logs
extra:
  note: |
    folded text
  raw: |
    line 1
    line 2

true
