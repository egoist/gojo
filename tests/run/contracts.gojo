// `requires` and `checkfree` (spec 14): preconditions that are facts for
// bounds-check elimination, and functions that must have no bounds checks.

checkfree fn dot(a: []f64, b: []f64) -> f64
    requires a.len() == b.len()
{
    var s = 0.0
    for i in 0..a.len() {
        s += a[i] * b[i]
    }
    return s
}

fn at(v: []int, i: int) -> int
    requires 0 <= i && i < v.len()
{
    return v[i]
}

fn main() {
    println(dot([1.0, 2.0], [3.0, 4.0]), at([5, 6], 1))
}
