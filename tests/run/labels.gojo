struct Res {
    name: String

    fn drop(inout self) {
        println("drop", self.name)
    }
}

fn find(grid: Vec[Vec[int]], target: int) -> ?int {
    var steps = 0
    rows: for row in grid {
        for x in row {
            steps += 1
            if x == target {
                break rows
            }
            if x < 0 {
                continue rows
            }
        }
    }
    return steps
}

fn main() {
    let grid = [[1, 2, 3], [-1, 9, 9], [4, 5, 6]]
    println(find(grid, 5), find(grid, 100))

    outer: for i in 0..3 {
        let _a = Res{name: "a" + String(rune('0' + i))}
        var j = 0
        loop {
            let _b = Res{name: "b" + String(rune('0' + j))}
            j += 1
            if j == 2 {
                continue outer
            }
            if i == 2 {
                break outer
            }
        }
    }

    let ch = Chan[Res](4)
    for n in ["x", "skip", "y"] {
        ch.tx <- Res{name: n.clone()}
    }
    drop(ch.tx)
    for r in ch.rx {
        if r.name == "skip" {
            continue
        }
        println("got", r.name)
    }
    println("done")
}
