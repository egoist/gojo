// ?Box[T], ?Rc[T], ?Arc[T] and ?Weak[T] are stored as a single pointer.
struct Node {
    value: int
    next: ?Box[Node]
}

fn length(n: Node) -> int {
    return match n.next {
        some(rest) => 1 + length(rest)
        none => 1
    }
}

fn main() {
    var list = Node{value: 1, next: none}
    for i in 2..6 {
        list = Node{value: i, next: Box(list)}
    }
    println(length(list), list.next?.value)

    let dup = list.clone()
    println(dup == list, dup.next.isSome())

    var boxes = Vec[?Box[int]]{}
    boxes.push(Box(7))
    boxes.push(none)
    let last = boxes.pop()
    let first = boxes.pop()
    println(last, first, boxes.pop())

    var m = Map[String, Box[int]]{}
    m["a"] = Box(1)
    let old = m.insert("a", Box(2))
    let gone = m.remove("a")
    println(old, gone, m.remove("a"))

    let ch = Chan[?Box[int]](2)
    ch.tx <- Box(3)
    ch.tx <- none
    drop(ch.tx)
    for v in ch.rx {
        println("got", v)
    }
    let r = <-ch.rx
    println("closed", r)

    let shared = Rc(10)
    let w = shared.downgrade()
    let up: ?Rc[int] = w.upgrade()
    let opt: ?Arc[String] = Arc("hi")
    println(up, opt, opt ?? Arc("no"))
}
