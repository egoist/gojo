// runtime-loaded: no C toolchain or headers needed at build time
extern "C" lib "libz" {
    fn crc32(crc u64, buf *u8, len u32) u64
}

extern "C" {
    fn abs(x i32) i32
    fn strlen(s *u8) u64
}

pub fn checksum(data []byte) u64 {
    return unsafe { crc32(0, data.ptr(), u32(data.len)) }
}

struct Node {
    value int
    next *Node
}

fn main() {
    println(checksum("hello world".bytes()))
    let n = unsafe { abs(-42) }
    println(n)
    let s = "kite\0"
    println(unsafe { strlen(s.ptr()) })
}
