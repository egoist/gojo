// Bounds-check elimination (src/codegen/bce.rs). Every index and slice of a
// vector, slice, array or string here says whether the compiler proves it in
// range (`proven`: no check) or keeps its check (`checked`), in the order they
// appear on the line; the `bounds_check_elimination` test compares that with
// the generated C, and runs the programs with the removed checks put back.

const N = 8
const Mask = N - 1

struct Grid {
    w: int
    cells: Vec[int]
}

struct Outer {
    g: Grid
    other: Vec[int]
}

fn opaque(x: int) -> int {
    if x == 123456789 {
        println("rare")
    }
    return x
}

fn bump(x: inout int) {
    x += 1
}

fn grow(v: inout Vec[int]) {
    v.push(0)
}

fn apply(f: fn(int)) {
    f(1)
}

// ---- proven: the loop's bound is the length of what it indexes

fn sum(v: []int) -> int {
    var s = 0
    for i in 0..v.len {
        s += v[i] // bce: proven
    }
    for i in 0..v.len() {
        s += opaque(v[i]) // bce: proven
    }
    return s
}

fn sumVec(v: Vec[int]) -> int {
    var s = 0
    for i in 0..v.len {
        s += opaque(v[i]) // bce: proven
    }
    return s
}

fn double(v: inout Vec[int]) {
    for i in 0..v.len {
        v[i] = v[i] * 2 // bce: proven proven
        bump(&v[i]) // bce: proven
    }
}

fn neighbours(v: []int) -> int {
    var s = 0
    for i in 1..v.len {
        s += v[i] - v[i - 1] // bce: proven proven
    }
    for i in 0..v.len - 1 {
        s += v[i] * v[i + 1] // bce: proven proven
    }
    for i in 2..=v.len - 1 {
        s += v[i - 2] + v[i] // bce: proven proven
    }
    return s
}

fn pairs(v: []int) -> int {
    var n = 0
    for i in 0..v.len {
        for j in i + 1..v.len {
            if v[i] < v[j] { // bce: proven proven
                n += 1
            }
        }
        for j in 0..i {
            n += v[j] & 1 // bce: proven
        }
    }
    return n
}

fn fields(o: inout Outer) -> int {
    var s = 0
    for i in 0..o.g.cells.len {
        s += o.g.cells[i] // bce: proven
        o.g.w += 1
        o.other.push(i)
        o.g.cells[i] = 0 // bce: proven
    }
    let b = Box(Grid{w: 0, cells: [5, 6]})
    for i in 0..b.cells.len {
        s += b.cells[i] // bce: proven
    }
    return s
}

fn indexed(v: Vec[int], a: [4]int) -> int {
    var s = 0
    for i, x in v {
        s += x * v[i] // bce: proven
    }
    for i, _ in a {
        s += a[i] // bce: proven
    }
    for i, x in v[1..] { // bce: checked
        s += x + v[i] // bce: checked
    }
    return s
}

fn bytes(s: String) -> int {
    var n = 0
    for i in 0..s.len {
        n += int(s[i]) // bce: proven
    }
    for i, _ in s {
        n += int(s[i]) // bce: proven
    }
    return n
}

fn arrays(a: [N]int, b: u8, x: int) -> int {
    var t: [256]int
    var s = a[0] + a[N - 1] + a[Mask] // bce: proven proven proven
    for i in 0..N {
        s += a[i] + a[N - 1 - i] // bce: proven checked
    }
    for i in 0..a.len {
        s += a[i] // bce: proven
    }
    t[b] = 1 // bce: proven
    s += t[x & 255] + t[int(b)] + a[x & Mask] // bce: proven proven proven
    if x >= 0 {
        s += a[x % N] // bce: checked
    }
    s += a[(x & 1023) % N] // bce: proven
    s += a[int(f64(x & 7))] + a[int(u8(x & 7))] // bce: checked proven
    return s
}

fn sized[K: int](a: [K]int) -> int {
    var s = 0
    for i in 0..K {
        s += a[i] // bce: proven
    }
    for i in 0..a.len {
        s += a[i] // bce: proven
    }
    return s
}

fn slices(v: []int) -> int {
    var s = 0
    for i in 0..v.len {
        s += v[i..].len + v[..i].len + v[i..i + 1][0] // bce: proven proven proven checked
    }
    let a: [4]int = [1, 2, 3, 4]
    s += a[1..3].len + a[..].len + a[2..][0] // bce: proven proven proven checked
    return s
}

fn readers(v: Vec[int]) -> int {
    var s = 0
    for i in 0..v.len {
        apply((k) => { s += v[i] * k }) // bce: checked
        s += v[i] // bce: proven
    }
    return s
}

fn hoisted(v: []int, w: inout Vec[int], x: int) -> int {
    let n = v.len
    let m = w.len() - 1
    var s = 0
    for i in 0..n {
        for j in i + 1..n {
            s += v[i] * v[j] // bce: proven proven
        }
    }
    for i in 0..=m {
        w[i] += 1 // bce: proven
    }
    let a: [8]int = [1, 2, 3, 4, 5, 6, 7, 8]
    let k = x & 7
    let last = a.len - 1
    return s + a[k] + a[last] + v[n - 1] // bce: proven proven checked
}

fn hoistedThenGrown(w: inout Vec[int]) -> int {
    let n = w.len
    var s = 0
    for i in 0..n {
        s += w[i] // bce: checked
    }
    w.push(s)
    return s
}

// ---- checked: the length may change, or the bound isn't known

fn changes(v: inout Vec[int], g: inout Grid) -> int {
    var s = 0
    for i in 0..v.len {
        v.push(1)
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        if i == 0 {
            grow(&v)
        }
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        s += v[i] // bce: checked
        if i == 1 {
            v = [9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9]
        }
    }
    for i in 0..v.len {
        apply((k) => { v.push(k) })
        s += v[i] // bce: checked
    }
    for i in 0..g.cells.len {
        s += g.cells[i] // bce: checked
        g = Grid{w: 1, cells: [1, 2, 3, 4, 5, 6, 7, 8, 9]}
    }
    return s
}

fn unknown(v: []int, w: []int, k: int) -> int {
    var s = 0
    for i in k..v.len {
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        if i < w.len {
            s += w[i] // bce: checked
        }
        if i + 1 < v.len {
            s += v[i + 1] // bce: checked
        }
        if i > 0 {
            s += v[i - 1] // bce: checked
        }
    }
    for i in 0..=v.len {
        if i < v.len {
            s += v[i] // bce: checked
        }
    }
    let p = v.ptr()
    for i in 0..v.len {
        unsafe {
            s += v[i] + *p // bce: checked
        }
    }
    return s
}

fn main() {
    var v: Vec[int] = [5, 3, 8, 1, 9, 2]
    println(sum(v[..]), sumVec(v), neighbours(v[..]), pairs(v[..])) // bce: proven proven proven
    double(&v)
    println(v)
    var o = Outer{g: Grid{w: 0, cells: [1, 2, 3]}, other: Vec[int]{}}
    println(fields(&o), o.g.w, o.g.cells, o.other)
    println(indexed(v, [1, 2, 3, 4]), bytes("héllo".toString()))
    let a: [8]int = [1, 2, 3, 4, 5, 6, 7, 8]
    let pair: [2]int = [7, 7]
    println(arrays(a, 200, 13), arrays(a, 0, -5), sized(a), sized(pair))
    println(slices(v[..]), readers(v)) // bce: proven
    var g = Grid{w: 0, cells: [1, 2]}
    var w: Vec[int] = [1, 2, 3]
    println(changes(&w, &g), w.len, g.cells)
    println(unknown(v[..], w[..2], 1)) // bce: proven checked
    println(hoisted(v[..], &w, 13), hoistedThenGrown(&w), w) // bce: proven
}
