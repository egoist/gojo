// Bounds-check elimination (src/codegen/bce.rs). Every index and slice of a
// vector, slice, array or string here says whether the compiler proves it in
// range (`proven`: no check) or keeps its check (`checked`), in the order they
// appear on the line; the `bounds_check_elimination` test compares that with
// the generated C, and runs the programs with the removed checks put back.

const N = 8
const Mask = N - 1

struct Grid {
    w: int
    cells: Vec[int]
}

struct Outer {
    g: Grid
    other: Vec[int]
}

fn opaque(x: int) -> int {
    if x == 123456789 {
        println("rare")
    }
    return x
}

fn bump(x: inout int) {
    x += 1
}

fn grow(v: inout Vec[int]) {
    v.push(0)
}

fn apply(f: fn(int)) {
    f(1)
}

// ---- proven: the loop's bound is the length of what it indexes

fn sum(v: []int) -> int {
    var s = 0
    for i in 0..v.len {
        s += v[i] // bce: proven
    }
    for i in 0..v.len() {
        s += opaque(v[i]) // bce: proven
    }
    return s
}

fn sumVec(v: Vec[int]) -> int {
    var s = 0
    for i in 0..v.len {
        s += opaque(v[i]) // bce: proven
    }
    return s
}

fn double(v: inout Vec[int]) {
    for i in 0..v.len {
        v[i] = v[i] * 2 // bce: proven proven
        bump(&v[i]) // bce: proven
    }
}

fn neighbours(v: []int) -> int {
    var s = 0
    for i in 1..v.len {
        s += v[i] - v[i - 1] // bce: proven proven
    }
    for i in 0..v.len - 1 {
        s += v[i] * v[i + 1] // bce: proven proven
    }
    for i in 2..=v.len - 1 {
        s += v[i - 2] + v[i] // bce: proven proven
    }
    return s
}

fn pairs(v: []int) -> int {
    var n = 0
    for i in 0..v.len {
        for j in i + 1..v.len {
            if v[i] < v[j] { // bce: proven proven
                n += 1
            }
        }
        for j in 0..i {
            n += v[j] & 1 // bce: proven
        }
    }
    return n
}

fn fields(o: inout Outer) -> int {
    var s = 0
    for i in 0..o.g.cells.len {
        s += o.g.cells[i] // bce: proven
        o.g.w += 1
        o.other.push(i)
        o.g.cells[i] = 0 // bce: proven
    }
    let b = Box(Grid{w: 0, cells: [5, 6]})
    for i in 0..b.cells.len {
        s += b.cells[i] // bce: proven
    }
    return s
}

fn indexed(v: Vec[int], a: [4]int) -> int {
    var s = 0
    for i, x in v {
        s += x * v[i] // bce: proven
    }
    for i, _ in a {
        s += a[i] // bce: proven
    }
    for i, x in v[1..] { // bce: checked
        s += x + v[i] // bce: checked
    }
    return s
}

fn bytes(s: String) -> int {
    var n = 0
    for i in 0..s.len {
        n += int(s[i]) // bce: proven
    }
    for i, _ in s {
        n += int(s[i]) // bce: proven
    }
    return n
}

fn arrays(a: [N]int, b: u8, x: int) -> int {
    var t: [256]int
    var s = a[0] + a[N - 1] + a[Mask] // bce: proven proven proven
    for i in 0..N {
        s += a[i] + a[N - 1 - i] // bce: proven checked
    }
    for i in 0..a.len {
        s += a[i] // bce: proven
    }
    t[b] = 1 // bce: proven
    s += t[x & 255] + t[int(b)] + a[x & Mask] // bce: proven proven proven
    if x >= 0 {
        s += a[x % N] // bce: proven
    }
    s += a[(x & 1023) % N] // bce: proven
    s += a[int(f64(x & 7))] + a[int(u8(x & 7))] // bce: checked proven
    return s
}

fn sized[K: int](a: [K]int) -> int {
    var s = 0
    for i in 0..K {
        s += a[i] // bce: proven
    }
    for i in 0..a.len {
        s += a[i] // bce: proven
    }
    return s
}

fn slices(v: []int) -> int {
    var s = 0
    for i in 0..v.len {
        s += v[i..].len + v[..i].len + v[i..i + 1][0] // bce: proven proven proven checked
    }
    let a: [4]int = [1, 2, 3, 4]
    s += a[1..3].len + a[..].len + a[2..][0] // bce: proven proven proven checked
    return s
}

fn readers(v: Vec[int]) -> int {
    var s = 0
    for i in 0..v.len {
        apply((k) => { s += v[i] * k }) // bce: checked
        s += v[i] // bce: proven
    }
    return s
}

fn hoisted(v: []int, w: inout Vec[int], x: int) -> int {
    let n = v.len
    let m = w.len() - 1
    var s = 0
    for i in 0..n {
        for j in i + 1..n {
            s += v[i] * v[j] // bce: proven proven
        }
    }
    for i in 0..=m {
        w[i] += 1 // bce: proven
    }
    let a: [8]int = [1, 2, 3, 4, 5, 6, 7, 8]
    let k = x & 7
    let last = a.len - 1
    return s + a[k] + a[last] + v[n - 1] // bce: proven proven checked
}

fn hoistedThenGrown(w: inout Vec[int]) -> int {
    let n = w.len
    var s = 0
    for i in 0..n {
        s += w[i] // bce: checked
    }
    w.push(s)
    return s
}

// ---- checked: the length may change, or the bound isn't known

fn changes(v: inout Vec[int], g: inout Grid) -> int {
    var s = 0
    for i in 0..v.len {
        v.push(1)
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        if i == 0 {
            grow(&v)
        }
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        s += v[i] // bce: checked
        if i == 1 {
            v = [9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9]
        }
    }
    for i in 0..v.len {
        apply((k) => { v.push(k) })
        s += v[i] // bce: checked
    }
    for i in 0..g.cells.len {
        s += g.cells[i] // bce: checked
        g = Grid{w: 1, cells: [1, 2, 3, 4, 5, 6, 7, 8, 9]}
    }
    return s
}

fn unknown(v: []int, w: []int, k: int) -> int {
    var s = 0
    for i in k..v.len {
        s += v[i] // bce: checked
    }
    for i in 0..v.len {
        if i < w.len {
            s += w[i] // bce: proven
        }
        if i + 1 < v.len {
            s += v[i + 1] // bce: checked
        }
        if i > 0 {
            s += v[i - 1] // bce: proven
        }
    }
    for i in 0..=v.len {
        if i < v.len {
            s += v[i] // bce: proven
        }
    }
    let p = v.ptr()
    for i in 0..v.len {
        unsafe {
            s += v[i] + *p // bce: checked
        }
    }
    return s
}

// What a condition says about a length: constant indexes after it.
fn lengths(parts: []String, xs: []int) -> int {
    var s = 0
    if parts.len() < 7 {
        return s
    }
    s += parts[1].len() + parts[5].len() // bce: proven proven
    s += parts[7].len() // bce: checked
    if xs.len() > 0 {
        s += xs[0] // bce: proven
    }
    if xs.isEmpty() {
        return s
    }
    s += xs[0] // bce: proven
    s += xs[1] // bce: checked
    return s
}

// What isn't a statement can change an index too: an `else if` condition
// and a block's value.
fn elseIf(v: []int, i0: int) -> int {
    var i = i0
    if i < 0 || i >= v.len {
        return 0
    } else if raise(&i) {
        return v[i] // bce: checked
    }
    return 0
}

fn blockValue(v: []int, i0: int) -> int {
    var i = i0
    let r = if i >= 0 && i < v.len {
        if raise(&i) { v[i] } else { 0 } // bce: checked
    } else {
        0
    }
    return r
}

fn fails(fail: bool) -> int ! String {
    if fail {
        return err("failed")
    }
    return 1
}

// deferred code emitted where `try` leaves says nothing about the way on
fn deferred(v: []int, j: int, fail: bool) -> int ! String {
    defer assert(j < v.len)
    defer assert(j >= 0)
    _ = try fails(fail)
    return v[j] // bce: checked
}

// a fact a nested exit's deferred code ends doesn't let a block's own
// facts outlive it
fn nestedExit(v: []int, j: int, k0: int, c: bool, d: bool) -> int {
    var k = k0
    defer k = 0
    if k < 0 || k > 9 {
        return 0
    }
    if c {
        if d {
            return 1
        }
        assert(j >= 0)
        assert(j < v.len)
    }
    return v[j] + k // bce: checked
}

// a length that changes after its guard
fn shrunk(v: inout Vec[int]) -> int {
    if v.len() >= 2 {
        _ = v.pop()
        return v[1] // bce: checked
    }
    return 0
}

// What a condition says about an index, where it holds.
fn guards(v: []int, n: int) -> int {
    var s = 0
    // the body of a `while`
    var i = 0
    while i < v.len {
        s += v[i] // bce: proven
        i += 1
    }
    // the right side of `&&`, each time round
    var k = 0
    while k < v.len && v[k] != 0 { // bce: proven
        k += 1
    }
    // changed before the use: no longer known
    var j = 0
    while j < v.len {
        j += 1
        s += v[j - 1] // bce: checked
        if j < v.len {
            s += v[j] // bce: proven
        }
    }
    // the rest of the block after an early exit
    if n < 0 || n >= v.len {
        return s
    }
    s += v[n] // bce: proven
    // a loop that changes it ends what the guard said, before its body
    var m = n
    if m < v.len {
        for _ in 0..2 {
            s += v[m] // bce: checked
            m += 1
        }
    }
    // a condition that changes what it compares tells nothing
    var c = 0
    if c < v.len && raise(&c) {
        s += v[c] // bce: checked
    }
    // the other branch of an early exit may change it
    var e = 0
    if e >= v.len {
        return s
    } else {
        e = v.len - 1
    }
    s += v[e] // bce: checked
    // after `assert`
    assert(k < v.len)
    s += v[k] // bce: proven
    // `>` and `<=`, and an `else`
    if v.len > n {
        s += v[n] // bce: proven
    } else {
        // (`assert(k < v.len)` above, with `k >= 0`, says `v` isn't empty)
        s += v[0] // bce: proven
    }
    return s
}

// (it could change `c` as it likes; it happens to leave it in range)
fn raise(c: inout int) -> bool {
    c += 0
    return true
}

// a length that changes after the guard
fn grown(w: inout Vec[int], i: int) -> int {
    if i >= 0 && i < w.len {
        w.push(4)
        return w[i] // bce: checked
    }
    return 0
}

struct Cursor {
    buf: Vec[int]
    pos: int

    // a field of `self` compared
    fn peek(self) -> int {
        if self.pos >= 0 && self.pos < self.buf.len {
            return self.buf[self.pos] // bce: proven
        }
        return -1
    }

    // (`self.pos` comes from the caller and may be negative, unless
    // compared as in `peek`)
    fn skip(inout self) {
        while self.pos < self.buf.len && self.buf[self.pos] == 0 { // bce: checked
            self.pos += 1
        }
    }
}

fn main() {
    var v: Vec[int] = [5, 3, 8, 1, 9, 2]
    println(sum(v[..]), sumVec(v), neighbours(v[..]), pairs(v[..])) // bce: proven proven proven
    double(&v)
    println(v)
    var o = Outer{g: Grid{w: 0, cells: [1, 2, 3]}, other: Vec[int]{}}
    println(fields(&o), o.g.w, o.g.cells, o.other)
    println(indexed(v, [1, 2, 3, 4]), bytes("héllo".toString()))
    let a: [8]int = [1, 2, 3, 4, 5, 6, 7, 8]
    let pair: [2]int = [7, 7]
    println(arrays(a, 200, 13), arrays(a, 0, -5), sized(a), sized(pair))
    println(slices(v[..]), readers(v)) // bce: proven
    var g = Grid{w: 0, cells: [1, 2]}
    var w: Vec[int] = [1, 2, 3]
    println(changes(&w, &g), w.len, g.cells)
    println(unknown(v[..], w[..2], 1)) // bce: proven checked
    println(hoisted(v[..], &w, 13), hoistedThenGrown(&w), w) // bce: proven
    println(guards([1, 2, 3, 0, 5][..], 2), guards([7, 0, 7][..], 1)) // bce: proven proven
    let words = ["a", "bb", "c", "dd", "e", "ff", "g", "hh"]
    let empty = Vec[int]{}
    println(lengths(words[..], [4, 5][..]), lengths(words[..3], empty[..])) // bce: proven proven checked proven
    var y: Vec[int] = [1, 2, 3]
    println(shrunk(&y))
    println(elseIf(v[..], 1), blockValue(v[..], 2), deferred(v[..], 1, false) catch { -1 }, nestedExit(v[..], 2, 1, false, false)) // bce: proven proven proven proven
    var x: Vec[int] = [1, 2, 3]
    println(grown(&x, 0))
    var cur = Cursor{buf: [0, 0, 4], pos: 0}
    cur.skip()
    println(cur.peek(), cur.pos)
}
