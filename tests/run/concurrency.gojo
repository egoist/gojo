use std/{fmt, time}

struct Job {
    id: int
    payload: String
}

struct Stats {
    hits: int
    names: Vec[String]
}

fn worker(id: int, jobs: Receiver[Job], results: Sender[String]) {
    for j in jobs {
        results <- fmt.sprint("worker", id, "did job", j.id, j.payload.len)
    }
}

fn square(x: int) -> int {
    time.sleep(time.millisecond)
    return x * x
}

// `out` is the only sender: the channel closes when it is dropped, here
fn producer(n: int, out: sink Sender[int]) {
    for i in 0..n {
        out <- i * i
    }
}

fn main() {
    // channels move ownership
    let jobs = Chan[Job](10)
    let results = Chan[String](10)
    go worker(1, jobs.rx.clone(), results.tx.clone())
    for i in 0..3 {
        let j = Job{id: i, payload: "x".repeat(i + 1)}
        jobs.tx <- j
    }
    // dropping the last sender closes the channel
    drop(jobs.tx)
    var got = Vec[String]{}
    for _ in 0..3 {
        if let r = <-results.rx {
            got.push(r)
        }
    }
    got.sort()
    for g in got {
        println(g)
    }

    // unbuffered channel; the producer takes the sender
    let sq = Chan[int]()
    go producer(5, sq.tx)
    var sum = 0
    for v in sq.rx {
        sum += v
    }
    println("sum of squares", sum)

    // shared state behind a mutex
    let stats = Arc(Mutex(Stats{hits: 0, names: Vec[String]{}}))
    let done = Chan[bool](4)
    for i in 0..4 {
        let s = stats.clone()
        let d = done.tx.clone()
        go () => {
            for _ in 0..1000 {
                with st = s.lock() {
                    st.hits += 1
                }
            }
            with st = s.lock() {
                st.names.push(fmt.sprint("g", i))
            }
            d <- true
        }
    }
    for _ in 0..4 {
        _ = <-done.rx
    }
    with st = stats.lock() {
        st.names.sort()
        println("hits", st.hits, st.names)
    }

    // select with timeout-ish default
    let a = Chan[int](1)
    let b = Chan[String](1)
    b.tx <- "hello"
    select {
        let x = <-a.rx => println("a", x)
        let y = <-b.rx => println("b", y)
    }
    select {
        let x = <-a.rx => println("a", x)
        _ => println("nothing ready")
    }

    // select in a loop: a send arm, a bare receive and a default arm
    let out = Chan[int](2)
    let quit = Chan[bool](1)
    var sent = 0
    var rounds = 0
    while sent < 3 {
        rounds += 1
        select {
            out.tx <- sent => sent += 1
            <-quit.rx => break
            _ => {
                // the buffer is full: take one value out
                if let v = <-out.rx {
                    println("drained", v)
                }
            }
        }
    }
    println("sent", sent, "buffered", out.rx.len(), "rounds", rounds)

    // structured concurrency: tasks borrow data from outside the scope
    let inputs = [1, 2, 3, 4, 5, 6, 7, 8]
    let total = Mutex(0)
    scope {
        for x in inputs {
            go () => {
                time.sleep(time.millisecond)
                with t = total.lock() {
                    t += x * 10
                }
            }
        }
    }
    with t = total.lock() {
        println("scope total", t)
    }

    // results as values, in order
    let squares = scope {
        let t3 = go square(3)
        let t4 = go square(4)
        t3.join() + t4.join()
    }
    println("squares", squares)
    ends()
}

fn ends() {
    // the last receiver gone: sends fail instead of blocking forever
    let ch = Chan[String](1)
    drop(ch.rx)
    println("sent to nobody:", ch.tx.send("x"))
    // several senders: the channel closes when the last one is dropped
    let c2 = Chan[int](4)
    scope {
        for i in 0..3 {
            let tx = c2.tx.clone()
            go () => { tx <- i }
        }
    }
    drop(c2.tx)
    var n = 0
    for v in c2.rx {
        n += v
    }
    println("from three senders:", n)
}
