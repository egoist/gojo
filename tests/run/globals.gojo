// Package-level values: computed once, on first use, by whichever task gets
// there first; shared state goes in a Mutex or an Atomic.
use std/fmt

struct Config {
    name String
    limit int
}

fn loadConfig() Config {
    println("loading the config, once")
    return Config{name: String("app"), limit: 3}
}

let config = loadConfig()
let hits = Atomic.new(0)
let names Mutex[Vec[String]] = Mutex(Vec[String]{})
let greeting = fmt.sprint("hello from", config.name)

fn record(s str) {
    _ = hits.add(1)
    with n = names.lock() { n.push(String(s)) }
}

fn main() {
    println("start")
    scope {
        for i in 0..8 {
            go () => {
                if i < config.limit {
                    record("x")
                }
            }
        }
    }
    println(greeting, hits.load())
    with n = names.lock() { println(n.len()) }
}
