// A cursor whose `next` yields parts of the collection: elements can outlive the
// iteration, like those of a `Vec`.
struct Ring {
    items Vec[String]

    fn cursor(self) int {
        return 0
    }

    fn next(self, c inout int) yield ?&String {
        if c >= self.items.len() {
            yield none
        }
        c += 1
        yield self.items[c - 1]
    }
}

fn main() {
    let r = Ring{items: ["a".toString(), "bbb".toString(), "cc".toString()]}
    var best = ""
    for s in r {
        if s.len() > best.len() {
            best = s.asStr()
        }
    }
    println(best)
}
