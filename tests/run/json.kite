// json: parsing, building, encoding, errors.
use json

fn show(text str) {
    let v = json.parse(text) catch e {
        println("error:", e.message())
        return
    }
    println(v.encode())
}

fn main() {
    let doc = `{"name": "kite", "version": 1, "pi": 3.25, "tags": ["fast", "safe"], "nested": {"ok": true, "nothing": null}, "big": 12345678901234567890, "esc": "a\"b\\c\né😀"}`
    let v = json.parse(doc).unwrap()
    println(v.encode())
    println(v.get("name").unwrap().str() ?? "?", v.get("version").unwrap().int() ?? 0, v.get("pi").unwrap().num() ?? 0.0)
    println(v.get("tags").unwrap().len(), v.get("tags").unwrap().at(1).unwrap().str() ?? "?", v.keys())
    if let n = v.get("nested") {
        println(n.get("ok").unwrap().boolean() ?? false, n.get("nothing").unwrap().isNull(), n.get("missing").isNone())
    }
    println(v.get("big").unwrap().int() ?? -1, v.get("big").unwrap().num() ?? 0.0)
    println(v.get("esc").unwrap().str() ?? "?")

    var out = json.object()
    out.set("id", json.integer(7))
    out.set("title", json.string("buy \"milk\""))
    var tags = json.array()
    tags.push(json.string("home"))
    tags.push(json.number(1.5))
    out.set("tags", tags)
    out.set("done", json.boolean(false))
    out.set("note", json.null())
    out.set("empty", json.object())
    println(out.encode())
    println(out.pretty())
    println(json.quoted("tab\there"))

    show(`[1, 2, 3]`)
    show(`  "just a string"  `)
    show(`-0.5e-3`)
    show(`{"a": 1,}`)
    show(`[1 2]`)
    show("{\n  \"a\": tru\n}")
    show(`"unterminated`)
    show(`01`)
    show(`"\ud800"`)
    show(`[1] x`)
    show("")
    show("[".repeat(600))
}
