// Set[T]
fn main() {
    var s = Set[String].new()
    println(s.insert("b"), s.insert("a"), s.insert("b"), s.len())
    println(s.contains("a"), s.contains("z"), s.toVec())
    var count = 0
    for x in s {
        count += x.len()
    }
    println(count)
    let a = setOf([1, 2, 3, 4])
    let b = setOf([3, 4, 5])
    println(a.union(b).toVec(), a.intersection(b).toVec(), a.difference(b).toVec())
    println(s.remove("a"), s.remove("a"), s.toVec(), s.isEmpty())
    s.clear()
    println(s.isEmpty())
}
