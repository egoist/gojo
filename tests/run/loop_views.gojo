// A view variable outside a loop that every iteration sets before using it:
// the owner may change in between.
fn main() {
    var s: String = "a"
    var t: String = "x"
    var w = ""
    for i in 0..3 {
        s.push("b")
        w = s.asStr()
        println(i, w)
    }
    println(w)
    for i in 0..2 {
        t = "fresh value number"
        w = t.asStr()
        println(i, w.len())
    }
    println(w)
}
