struct NotFound {
    name: String
}

fn find(name: str) -> int ! NotFound {
    if name == "x" {
        return 1
    }
    return err(NotFound{name: name.toString()})
}

fn lookup(name: str) -> int ! NotFound {
    let n = try find(name)
    return n + 1
}

fn run() -> int ! NotFound {
    let a = try lookup("x")
    let b = lookup("y") catch _e { 0 }
    let c = try lookup("z")
    return a + b + c
}

fn main() ! NotFound {
    println(try run())
}
