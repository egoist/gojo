use ./geom.{Vec2, Shape, origin}
use ./util/text as t
use ./geom

fn total(shapes: []Shape) -> f64 {
    var sum = 0.0
    for s in shapes {
        sum += s.area()
    }
    return sum
}

fn main() {
    let v = Vec2{x: 3.0, y: 4.0}
    println(v.length(), origin())
    var shapes = Vec[Shape]{}
    shapes.push(geom.Square{side: 2.0})
    shapes.push(geom.Square{side: 1.5})
    println(total(shapes))
    println(t.shout("gojo"), geom.describe(v))
}
