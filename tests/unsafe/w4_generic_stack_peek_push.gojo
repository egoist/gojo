struct Stack[T] {
    items: Vec[T]

    fn peek(self) yield &T {
        yield self.items[self.items.len() - 1]
    }

    fn push(inout self, x: sink T) {
        self.items.push(x)
    }
}
fn main() {
    var st = Stack[String]{items: ["abcdefghijklmnopqrstuvwxyz0123456789".toString()]}
    var keep = ""
    with top = st.peek() {
        keep = top.asStr()
    }
    for _ in 0..100 {
        st.push("x".toString())
    }
    println(keep)
}
