fn take(s: sink String) {}
fn main() {
    let ch = Chan[int](2)
    ch.tx <- 1
    ch.tx <- 2
    let s = "abcdefghijklmnopqrstuvwxyz0123456789".toString()
    for _ in 0..2 {
        select {
            let x = <-ch.rx => {
                take(s)
                println(x)
            }
        }
    }
}
