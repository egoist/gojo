// the range's bound is declared inside the task, so it covers many elements
// over time: it can't be told apart from the other task's range
fn set(v: inout []int, x: int) {
    v[0] = x
}

fn main() {
    var xs = [0, 0, 0, 0]
    scope {
        go () => {
            for i in 0..4 {
                set(&xs[i..i + 1], 1)
            }
        }
        go set(&xs[3..], 2)
    }
    println(xs)
}
